index 0000000..64f25fb
--- /dev/null
+++ b/src/components/admin-orders.tsx
@@ -0,0 +1,309 @@
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { ClipboardList, RefreshCw, Search } from "lucide-react";
+import { useState, type FormEvent } from "react";
+import {
+  AlertDialog,
+  AlertDialogCancel,
+  AlertDialogContent,
+  AlertDialogDescription,
+  AlertDialogFooter,
+  AlertDialogHeader,
+  AlertDialogTitle,
+} from "@/components/ui/alert-dialog";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { brlFmt } from "@/lib/cart";
+import { operationsQuery, payments, type Payment } from "@/lib/operations";
+import { orderCode, ordersClient, type ShopOrder } from "@/lib/orders";
+
+const pageSize = 20;
+const orderFields =
+  "id,code,customer_name,phone,address,items,total,created_at,confirmed_at,sale_id";
+const dateTime = new Intl.DateTimeFormat("pt-BR", { dateStyle: "short", timeStyle: "short" });
+
+export function AdminOrders({ linkedCode }: { linkedCode: string | undefined }) {
+  const [input, setInput] = useState(linkedCode ?? "");
+  const [code, setCode] = useState(linkedCode);
+  const [page, setPage] = useState(0);
+  const [selected, setSelected] = useState<ShopOrder | null>(null);
+  const [payment, setPayment] = useState<Payment | "">("");
+  const client = useQueryClient();
+
+  const { data, isPending, isError, isFetching, refetch } = useQuery({
+    queryKey: ["shop-orders", code, page],
+    queryFn: async () => {
+      let request = ordersClient.from("shop_orders").select(orderFields, { count: "exact" });
+      request = code ? request.eq("code", code) : request.is("confirmed_at", null);
+      const { data, error, count } = await request
+        .order("created_at", { ascending: false })
+        .order("id", { ascending: false })
+        .range(page * pageSize, (page + 1) * pageSize - 1);
+      if (error) throw error;
+      return { orders: data, count: count ?? 0 };
+    },
+    refetchInterval: 30_000,
+  });
+
+  const confirmation = useMutation({
+    mutationFn: async ({ order, method }: { order: ShopOrder; method: Payment }) => {
+      const { error } = await ordersClient.rpc("confirm_shop_order", {
+        p_order_id: order.id,
+        p_payment: method,
+      });
+      if (error) {
+        throw new Error(
+          error.code === "P0001"
+            ? error.message
+            : "Não foi possível confirmar a venda. Tente novamente.",
+        );
+      }
+    },
+    onSuccess: async () => {
+      if (selected) {
+        setInput(selected.code);
+        setCode(selected.code);
+        setPage(0);
+      }
+      setSelected(null);
+      await Promise.all([
+        client.invalidateQueries({ queryKey: ["shop-orders"] }),
+        client.invalidateQueries({ queryKey: operationsQuery.queryKey }),
+      ]);
+    },
+  });
+
+  function search(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    setCode(orderCode.parse(input.trim()));
+    setPage(0);
+  }
+
+  function openConfirmation(order: ShopOrder) {
+    confirmation.reset();
+    setSelected(order);
+    setPayment("");
+  }
+
+  return (
+    <section className="space-y-5" aria-labelledby="pending-orders-title">
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <div>
+          <h1 id="pending-orders-title" className="font-display text-3xl font-bold">
+            Pedidos pendentes
+          </h1>
+          <p className="mt-1 text-sm text-muted-foreground">
+            Pesquise pelo código recebido no WhatsApp.
+          </p>
+        </div>
+        <Button
+          type="button"
+          variant="outline"
+          disabled={isFetching}
+          onClick={() => void refetch()}
+        >
+          <RefreshCw className="h-4 w-4" aria-hidden="true" />
+          Atualizar
+        </Button>
+      </div>
+
+      <form onSubmit={search} className="flex flex-wrap items-end gap-2">
+        <div className="w-full max-w-52">
+          <label htmlFor="order-code" className="mb-1 block text-sm font-medium">
+            Código do pedido
+          </label>
+          <Input
+            id="order-code"
+            value={input}
+            onChange={(e) => setInput(e.target.value)}
+            inputMode="numeric"
+            pattern="[0-9]{1,15}"
+            maxLength={15}
+            placeholder="0443"
+          />
+        </div>
+        <Button type="submit" variant="commerce">
+          <Search className="h-4 w-4" aria-hidden="true" />
+          Pesquisar
+        </Button>
+        {code && (
+          <Button
+            type="button"
+            variant="ghost"
+            onClick={() => {
+              setInput("");
+              setCode(undefined);
+              setPage(0);
+            }}
+          >
+            Voltar aos pendentes
+          </Button>
+        )}
+      </form>
+
+      {isPending && (
+        <p role="status" className="text-sm text-muted-foreground">
+          Carregando pedidos…
+        </p>
+      )}
+      {isError && (
+        <p role="alert" className="text-sm text-destructive">
+          Não foi possível carregar os pedidos. Use Atualizar para tentar novamente.
+        </p>
+      )}
+      {data?.orders.length === 0 && (
+        <p className="rounded-xl border border-border bg-card p-5 text-sm text-muted-foreground">
+          {code
+            ? `Pedido #${code} não encontrado.`
+            : page
+              ? "Nenhum pedido nesta página."
+              : "Nenhum pedido pendente."}
+        </p>
+      )}
+      <div className="grid gap-4 lg:grid-cols-2">
+        {data?.orders.map((order) => (
+          <article
+            key={order.id}
+            className="overflow-hidden rounded-xl border border-border bg-card"
+          >
+            <header className="flex flex-wrap items-center justify-between gap-2 border-b border-border px-5 py-4">
+              <div className="flex items-center gap-2">
+                <ClipboardList className="h-4 w-4 text-muted-foreground" aria-hidden="true" />
+                <h2 className="font-display font-bold">Pedido #{order.code}</h2>
+              </div>
+              <span className="rounded-full bg-secondary px-3 py-1 text-xs font-semibold">
+                {order.confirmed_at ? "Venda confirmada" : "Pendente"}
+              </span>
+            </header>
+            <div className="space-y-4 p-5">
+              <dl className="grid grid-cols-2 gap-3 break-words text-sm">
+                <div>
+                  <dt className="text-muted-foreground">Cliente</dt>
+                  <dd className="font-medium">{order.customer_name}</dd>
+                </div>
+                <div>
+                  <dt className="text-muted-foreground">Telefone</dt>
+                  <dd className="font-medium">
+                    <a className="hover:underline" href={`tel:${order.phone}`}>
+                      {order.phone}
+                    </a>
+                  </dd>
+                </div>
+                <div className="col-span-2">
+                  <dt className="text-muted-foreground">Endereço de entrega</dt>
+                  <dd className="whitespace-pre-line font-medium">{order.address}</dd>
+                </div>
+              </dl>
+              <ul className="divide-y divide-border border-y border-border text-sm">
+                {order.items.map((line) => (
+                  <li
+                    key={JSON.stringify([line.product_id, line.flavor])}
+                    className="flex justify-between gap-3 py-2"
+                  >
+                    <div className="min-w-0 break-words">
+                      {line.quantity} × {line.product_name}
+                      {line.flavor && (
+                        <span className="block text-muted-foreground">{line.flavor}</span>
+                      )}
+                    </div>
+                    <span className="shrink-0">{brlFmt(line.unit_price * line.quantity)}</span>
+                  </li>
+                ))}
+              </ul>
+              <div className="flex flex-wrap justify-between gap-2 text-sm">
+                <time className="text-muted-foreground" dateTime={order.created_at}>
+                  {dateTime.format(new Date(order.created_at))}
+                </time>
+                <span className="font-bold">Total {brlFmt(order.total)}</span>
+              </div>
+              {!order.confirmed_at && (
+                <Button type="button" variant="commerce" onClick={() => openConfirmation(order)}>
+                  Confirmar venda
+                </Button>
+              )}
+            </div>
+          </article>
+        ))}
+      </div>
+      {(page > 0 || (data?.count ?? 0) > pageSize) && (
+        <nav aria-label="Páginas de pedidos" className="flex items-center gap-3">
+          <Button
+            variant="outline"
+            disabled={page === 0 || isFetching}
+            onClick={() => setPage((value) => value - 1)}
+          >
+            Anterior
+          </Button>
+          <span className="text-sm text-muted-foreground">Página {page + 1}</span>
+          <Button
+            variant="outline"
+            disabled={isFetching || (page + 1) * pageSize >= (data?.count ?? 0)}
+            onClick={() => setPage((value) => value + 1)}
+          >
+            Próxima
+          </Button>
+        </nav>
+      )}
+
+      <AlertDialog
+        open={!!selected}
+        onOpenChange={(open) => {
+          if (!open && !confirmation.isPending) setSelected(null);
+        }}
+      >
+        <AlertDialogContent>
+          <AlertDialogHeader>
+            <AlertDialogTitle>Confirmar venda do pedido #{selected?.code}</AlertDialogTitle>
+            <AlertDialogDescription>
+              Registre a forma de pagamento recebida para baixar os itens do estoque e lançar{" "}
+              {brlFmt(selected?.total ?? 0)} no financeiro.
+            </AlertDialogDescription>
+          </AlertDialogHeader>
+          <form
+            onSubmit={(e) => {
+              e.preventDefault();
+              if (selected && payment && !confirmation.isPending)
+                confirmation.mutate({ order: selected, method: payment });
+            }}
+            className="space-y-4"
+          >
+            <div>
+              <label htmlFor="order-payment" className="text-sm font-semibold">
+                Forma de pagamento
+              </label>
+              <select
+                id="order-payment"
+                required
+                value={payment}
+                disabled={confirmation.isPending}
+                onChange={(e) => setPayment(e.target.value as Payment | "")}
+                className="mt-1 w-full rounded-lg border border-input bg-secondary p-2 text-sm"
+              >
+                <option value="">Selecione</option>
+                {Object.entries(payments).map(([value, label]) => (
+                  <option key={value} value={value}>
+                    {label}
+                  </option>
+                ))}
+              </select>
+            </div>
+            {confirmation.error && (
+              <p role="alert" className="text-sm text-destructive">
+                {confirmation.error.message}
+              </p>
+            )}
+            <AlertDialogFooter>
+              <AlertDialogCancel disabled={confirmation.isPending}>Voltar</AlertDialogCancel>
+              <Button
+                type="submit"
+                variant="commerce"
+                disabled={!payment || confirmation.isPending}
+              >
+                {confirmation.isPending ? "Confirmando…" : "Dar baixa na venda"}
+              </Button>
+            </AlertDialogFooter>
+          </form>
+        </AlertDialogContent>
+      </AlertDialog>
+    </section>
+  );
+}
