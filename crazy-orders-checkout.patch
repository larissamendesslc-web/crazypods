index 0000000..5d623e5
--- /dev/null
+++ b/src/components/cart-checkout.tsx
@@ -0,0 +1,222 @@
+import { useRef, useState, type FormEvent, type ReactNode } from "react";
+import { MessageCircle } from "lucide-react";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { Textarea } from "@/components/ui/textarea";
+import { brlFmt, cartCount, cartTotal, type CartItem } from "@/lib/cart";
+import { deliverySchema, orderCode, orderMessage, ordersClient } from "@/lib/orders";
+
+const receiptKey = "crazypods-last-order";
+
+function lastOrder() {
+  try {
+    return orderCode.parse(sessionStorage.getItem(receiptKey));
+  } catch {
+    return undefined;
+  }
+}
+
+type Props = {
+  items: CartItem[];
+  whatsappBase: string;
+  onComplete: () => void;
+  onClear: () => void;
+  children: ReactNode;
+};
+
+export function CartCheckout({ items, whatsappBase, onComplete, onClear, children }: Props) {
+  const [code, setCode] = useState(lastOrder);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const inFlight = useRef(false);
+  const request = useRef<{ fingerprint: string; id: string } | null>(null);
+
+  function whatsappUrl(order: string) {
+    return whatsappBase + encodeURIComponent(orderMessage(order, window.location.origin));
+  }
+
+  async function checkout(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (inFlight.current || !items.length) return;
+
+    const fields = new FormData(event.currentTarget);
+    const delivery = deliverySchema.safeParse({
+      name: fields.get("name"),
+      phone: fields.get("phone"),
+      address: fields.get("address"),
+    });
+    if (!delivery.success) {
+      setError(delivery.error.issues[0]?.message ?? "Revise seus dados de entrega.");
+      return;
+    }
+
+    const lines = items.map(({ id, flavor, qty, price }) => ({
+      product_id: id,
+      flavor: flavor ?? "",
+      quantity: qty,
+      expected_price: price,
+    }));
+    const fingerprint = JSON.stringify({ delivery: delivery.data, lines });
+    if (request.current?.fingerprint !== fingerprint) {
+      request.current = { fingerprint, id: crypto.randomUUID() };
+    }
+
+    inFlight.current = true;
+    setBusy(true);
+    setError("");
+    // Open in the click gesture so mobile browsers can hand off to WhatsApp.
+    let popup: Window | null = null;
+    try {
+      popup = window.open("about:blank", "_blank");
+      if (popup) popup.opener = null;
+    } catch {
+      // The saved order still offers a direct WhatsApp link.
+    }
+    try {
+      const { data, error: failure } = await ordersClient.rpc("create_shop_order", {
+        p_request_id: request.current.id,
+        p_name: delivery.data.name,
+        p_phone: delivery.data.phone,
+        p_address: delivery.data.address,
+        p_items: lines,
+      });
+      if (failure || !data) {
+        const detail = failure?.code === "P0001" ? failure.message : undefined;
+        throw new Error(detail || "Não foi possível salvar o pedido. Tente novamente.");
+      }
+      try {
+        sessionStorage.setItem(receiptKey, data);
+      } catch {
+        // The receipt remains available in the open cart if storage is blocked.
+      }
+      setCode(data);
+      request.current = null;
+      onComplete();
+      try {
+        if (popup && !popup.closed) popup.location.replace(whatsappUrl(data));
+      } catch {
+        popup?.close();
+      }
+    } catch (cause) {
+      popup?.close();
+      setError(cause instanceof Error ? cause.message : "Não foi possível salvar o pedido.");
+    } finally {
+      inFlight.current = false;
+      setBusy(false);
+    }
+  }
+
+  return (
+    <form onSubmit={checkout} className="flex min-h-0 flex-1 flex-col">
+      <fieldset disabled={busy} className="min-h-0 flex-1 space-y-3 overflow-y-auto p-5">
+        {items.length === 0 && code ? (
+          <div className="space-y-3 rounded-xl border border-border bg-secondary p-4">
+            <p role="status" className="font-display text-lg font-bold">
+              Pedido #{code} criado
+            </p>
+            <p className="text-sm text-muted-foreground">
+              Envie a mensagem no WhatsApp para a loja localizar seu pedido.
+            </p>
+            <a
+              href={whatsappUrl(code)}
+              target="_blank"
+              rel="noopener noreferrer"
+              className="inline-flex items-center gap-2 rounded-full bg-whatsapp px-5 py-3 text-sm font-bold text-primary-foreground"
+            >
+              <MessageCircle className="h-4 w-4" aria-hidden="true" />
+              Abrir WhatsApp
+            </a>
+          </div>
+        ) : (
+          children
+        )}
+
+        {items.length > 0 && (
+          <section
+            aria-labelledby="delivery-heading"
+            className="mt-5 space-y-3 rounded-xl border border-border bg-secondary/40 p-4"
+          >
+            <h2 id="delivery-heading" className="font-display font-semibold">
+              Dados para entrega
+            </h2>
+            <div>
+              <label htmlFor="cart-customer-name" className="text-sm font-medium">
+                Nome completo
+              </label>
+              <Input
+                id="cart-customer-name"
+                name="name"
+                autoComplete="name"
+                required
+                minLength={2}
+                maxLength={120}
+                className="mt-1"
+              />
+            </div>
+            <div>
+              <label htmlFor="cart-customer-phone" className="text-sm font-medium">
+                Telefone com DDD
+              </label>
+              <Input
+                id="cart-customer-phone"
+                name="phone"
+                type="tel"
+                autoComplete="tel"
+                required
+                maxLength={25}
+                className="mt-1"
+              />
+            </div>
+            <div>
+              <label htmlFor="cart-customer-address" className="text-sm font-medium">
+                Endereço de entrega
+              </label>
+              <Textarea
+                id="cart-customer-address"
+                name="address"
+                autoComplete="street-address"
+                placeholder="Rua, número, complemento, bairro, cidade e CEP"
+                required
+                minLength={8}
+                maxLength={500}
+                className="mt-1 min-h-20"
+              />
+            </div>
+          </section>
+        )}
+      </fieldset>
+      {items.length > 0 && (
+        <div className="border-t border-border bg-card p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))]">
+          <div className="flex items-center justify-between gap-2">
+            <span className="text-sm text-muted-foreground">Subtotal ({cartCount(items)})</span>
+            <span className="font-display text-2xl font-bold text-gradient">
+              {brlFmt(cartTotal(items))}
+            </span>
+          </div>
+          {error && (
+            <p role="alert" className="mt-2 text-sm text-destructive">
+              {error}
+            </p>
+          )}
+          <Button
+            type="submit"
+            disabled={busy}
+            className="mt-3 h-auto min-h-12 w-full whitespace-normal rounded-full bg-whatsapp py-3 font-bold text-primary-foreground hover:bg-whatsapp/90"
+          >
+            <MessageCircle className="h-5 w-5" aria-hidden="true" />
+            {busy ? "Criando pedido…" : "Enviar pedido no WhatsApp"}
+          </Button>
+          <Button
+            type="button"
+            variant="ghost"
+            onClick={onClear}
+            disabled={busy}
+            className="mt-1 w-full text-sm text-muted-foreground"
+          >
+            Esvaziar carrinho
+          </Button>
+        </div>
+      )}
+    </form>
+  );
+}
