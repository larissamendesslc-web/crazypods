diff --git a/src/lib/orders.ts b/src/lib/orders.ts
new file mode 100644
index 0000000..8d2e2fc
--- /dev/null
+++ b/src/lib/orders.ts
@@ -0,0 +1,83 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { z } from "zod";
+import { supabase } from "@/integrations/supabase/client";
+import type { Database } from "@/integrations/supabase/types";
+import type { Payment } from "@/lib/operations";
+
+export const orderCode = z.preprocess(
+  (value) => (typeof value === "number" ? String(value) : value),
+  z
+    .string()
+    .regex(/^[0-9]{1,15}$/)
+    .transform((value) => value.replace(/^0+(?=\d)/, "").padStart(4, "0"))
+    .optional()
+    .catch(undefined),
+);
+
+export const deliverySchema = z.object({
+  name: z.string().trim().min(2, "Informe seu nome.").max(120),
+  phone: z
+    .string()
+    .trim()
+    .transform((value) => value.replace(/\D/g, ""))
+    .pipe(z.string().regex(/^(?:55)?[1-9][0-9]{9,10}$/, "Informe um telefone com DDD.")),
+  address: z.string().trim().min(8, "Informe rua, número, bairro e cidade.").max(500),
+});
+
+export type OrderLine = {
+  product_id: string;
+  product_name: string;
+  flavor: string;
+  quantity: number;
+  unit_price: number;
+};
+
+export type ShopOrder = {
+  id: string;
+  code: string;
+  customer_name: string;
+  phone: string;
+  address: string;
+  items: OrderLine[];
+  total: number;
+  created_at: string;
+  confirmed_at: string | null;
+  sale_id: string | null;
+};
+
+type OrdersDatabase = {
+  public: Omit<Database["public"], "Tables" | "Functions"> & {
+    Tables: Database["public"]["Tables"] & {
+      shop_orders: { Row: ShopOrder; Insert: never; Update: never; Relationships: [] };
+    };
+    Functions: Database["public"]["Functions"] & {
+      create_shop_order: {
+        Args: {
+          p_request_id: string;
+          p_name: string;
+          p_phone: string;
+          p_address: string;
+          p_items: {
+            product_id: string;
+            flavor: string;
+            quantity: number;
+            expected_price: number;
+          }[];
+        };
+        Returns: string;
+      };
+      confirm_shop_order: {
+        Args: { p_order_id: string; p_payment: Payment };
+        Returns: string;
+      };
+    };
+  };
+};
+
+export const ordersClient = supabase as unknown as SupabaseClient<OrdersDatabase>;
+
+export function orderMessage(code: string, origin: string) {
+  const url = new URL("/admin", origin);
+  url.searchParams.set("pedido", code);
+  return `Olá, este é meu pedido: ${code}\n${url.href}`;
+}
