@@ -0,0 +1,232 @@
+import { useState } from "react";
+import { useQuery, useQueryClient } from "@tanstack/react-query";
+import { Eye, Snowflake } from "lucide-react";
+import logo from "@/assets/crazy-pods-logo.png.asset.json";
+import { Button } from "@/components/ui/button";
+import { Dialog, DialogContent, DialogDescription, DialogTitle } from "@/components/ui/dialog";
+import { Switch } from "@/components/ui/switch";
+import {
+  ChristmasCrystals,
+  ChristmasFooterMessage,
+  ChristmasHat,
+  ChristmasHeaderLights,
+  SnowfallEffect,
+} from "@/components/christmas-theme";
+import { WhatsAppIcon } from "@/components/shop";
+import {
+  DEFAULT_SEASON,
+  fromLocalSchedule,
+  toLocalSchedule,
+  type SeasonSettings,
+} from "@/lib/seasons";
+import { saveSeason, settingsQuery } from "@/lib/settings";
+
+const toggles = [
+  ["enabled", "Modo Natal"],
+  ["whatsappHat", "Gorro do WhatsApp"],
+  ["logoHat", "Decoração da logo"],
+  ["lights", "Luzes natalinas"],
+  ["trim", "Decoração do cabeçalho, banner e rodapé"],
+] as const;
+
+const fieldClass =
+  "mt-1 block w-full min-w-0 rounded-lg border border-input bg-secondary px-3 py-2 text-sm [color-scheme:dark]";
+
+export function SeasonalThemeSettings() {
+  const query = useQuery(settingsQuery);
+  const client = useQueryClient();
+  const [draft, setDraft] = useState<SeasonSettings>();
+  const [preview, setPreview] = useState(false);
+  const [saving, setSaving] = useState(false);
+  const [status, setStatus] = useState("");
+  const [error, setError] = useState("");
+  const season = draft ?? query.data?.season ?? DEFAULT_SEASON;
+  const invalidRange = !!(
+    season.start &&
+    season.end &&
+    Date.parse(season.start) >= Date.parse(season.end)
+  );
+
+  function set<K extends keyof SeasonSettings>(key: K, value: SeasonSettings[K]) {
+    setDraft({ ...season, [key]: value });
+    setStatus("");
+    setError("");
+  }
+
+  async function save(value: SeasonSettings) {
+    setStatus("");
+    setError("");
+    setSaving(true);
+    try {
+      await saveSeason(value);
+      client.setQueryData(
+        settingsQuery.queryKey,
+        (previous) => previous && { ...previous, season: value },
+      );
+      setDraft(undefined);
+      setStatus(value.enabled ? "Aparência sazonal salva." : "Aparência original restaurada.");
+      void client.invalidateQueries({ queryKey: settingsQuery.queryKey });
+    } catch {
+      setError("Não foi possível salvar. Confira a conexão e as permissões da sua conta.");
+    } finally {
+      setSaving(false);
+    }
+  }
+
+  return (
+    <section
+      className="rounded-2xl border border-violet-300/20 bg-gradient-to-br from-violet-400/10 to-background p-5 sm:p-6"
+      aria-labelledby="seasons-heading"
+    >
+      <div className="flex items-center gap-3">
+        <Snowflake aria-hidden="true" className="size-8 shrink-0 text-violet-200" />
+        <div>
+          <p className="text-xs text-muted-foreground">Aparência sazonal</p>
+          <h2 id="seasons-heading" className="font-display text-xl font-bold">
+            CRAZY SEASONS
+          </h2>
+          <p className="text-sm text-violet-200">Christmas Edition — Black Ice</p>
+        </div>
+      </div>
+      {query.isPending && (
+        <p role="status" className="mt-4 text-sm">
+          Carregando configuração…
+        </p>
+      )}
+      {query.isError && (
+        <p role="alert" className="mt-4 text-sm text-red-300">
+          Não foi possível consultar a configuração.{" "}
+          <button type="button" className="underline" onClick={() => void query.refetch()}>
+            Tentar novamente
+          </button>
+        </p>
+      )}
+      <fieldset
+        className="mt-4 grid gap-3 sm:grid-cols-2"
+        disabled={saving || query.isPending || query.isError}
+      >
+        {toggles.map(([key, label]) => (
+          <label
+            key={key}
+            className="flex items-center justify-between gap-3 rounded-lg border border-border px-3 py-2 text-sm"
+          >
+            {label}
+            <Switch
+              className="shrink-0"
+              checked={season[key]}
+              onCheckedChange={(value) => set(key, value)}
+            />
+          </label>
+        ))}
+        <label className="text-sm">
+          Intensidade da neve
+          <select
+            className={fieldClass}
+            value={season.snow}
+            onChange={(e) => set("snow", e.target.value as SeasonSettings["snow"])}
+          >
+            <option value="soft">Suave</option>
+            <option value="medium">Média</option>
+            <option value="strong">Intensa</option>
+          </select>
+        </label>
+        <label className="min-w-0 text-sm">
+          Início
+          <input
+            className={fieldClass}
+            type="datetime-local"
+            value={toLocalSchedule(season.start)}
+            onChange={(e) => set("start", fromLocalSchedule(e.target.value))}
+          />
+        </label>
+        <label className="min-w-0 text-sm">
+          Término
+          <input
+            className={fieldClass}
+            type="datetime-local"
+            value={toLocalSchedule(season.end)}
+            onChange={(e) => set("end", fromLocalSchedule(e.target.value))}
+          />
+        </label>
+      </fieldset>
+      <p className="mt-2 text-xs text-muted-foreground">
+        Horário de Brasília. Com o modo ativado, datas vazias deixam o tema disponível imediatamente
+        e sem término.
+      </p>
+      {invalidRange && (
+        <p role="alert" className="mt-2 text-sm text-red-300">
+          O término precisa ser posterior ao início.
