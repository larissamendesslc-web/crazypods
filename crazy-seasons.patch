+  refetchInterval: 30_000,
+  retry: false,
   queryFn: async (): Promise<SiteSettings> => {
-    const { data } = await supabase.from("site_settings").select("data").eq("id", 1).maybeSingle();
-    return { ...DEFAULT_SETTINGS, ...((data?.data as Partial<SiteSettings>) ?? {}) };
+    const row = await readSettings();
+    const raw = settingsObject(row?.data);
+    return {
+      ...DEFAULT_SETTINGS,
+      ...Object.fromEntries(
+        Object.keys(DEFAULT_SETTINGS)
+          .filter((key) => key in raw && key !== "season")
+          .map((key) => [key, raw[key]]),
+      ),
+      season: readEngine(raw[engineKey], raw[seasonKey]),
+    };
   },
 });
 
+export function saveSeason(season: ThemeEngine, expected: ThemeEngine) {
+  return saveSettingsPatch({ [engineKey]: season }, (raw) => {
+    if (
+      JSON.stringify(readEngine(raw[engineKey], raw[seasonKey])) !==
+      JSON.stringify(readEngine(expected, undefined))
+    ) {
+      throw new Error("Os temas foram atualizados em outra sessão. Recarregue antes de salvar.");
+    }
+  });
+}
+
+export async function saveSettingsPatch(
+  patch: Record<string, Json | undefined>,
+  check?: (current: Record<string, Json | undefined>) => void,
+) {
+  for (let attempt = 0; attempt < 3; attempt++) {
+    const row = await readSettings();
+    const raw = settingsObject(row?.data);
+    check?.(raw);
+    const data = { ...raw, ...patch };
+    if (!row) {
+      const { error } = await supabase.from("site_settings").insert({ id: 1, data });
+      if (!error) return;
+      if (error.code === "23505") continue;
+      throw error;
+    }
+
+    const updatedAt = new Date(Math.max(Date.now(), Date.parse(row.updated_at) + 1)).toISOString();
+    const { data: updated, error } = await supabase
+      .from("site_settings")
+      .update({ data, updated_at: updatedAt })
+      .eq("id", 1)
+      .eq("updated_at", row.updated_at)
+      .select("id")
+      .maybeSingle();
+    if (error) throw error;
+    if (updated) return;
+    const current = await readSettings();
+    if (current?.updated_at === row.updated_at) throw new Error("Permissão de gravação negada.");
+  }
+  throw new Error("Configurações alteradas por outra sessão. Tente salvar novamente.");
+}
+
 export const waBase = (s: SiteSettings) => `https://wa.me/${s.whatsapp.replace(/\D/g, "")}?text=`;
