+import { useState } from "react";
+import { useQuery, useQueryClient } from "@tanstack/react-query";
+import { CircuitBoard, MoonStar, Snowflake, Sparkles, Circle } from "lucide-react";
+import logo from "@/assets/crazy-pods-logo.png.asset.json";
+import { Button } from "@/components/ui/button";
+import { Dialog, DialogContent, DialogDescription, DialogTitle } from "@/components/ui/dialog";
+import { Switch } from "@/components/ui/switch";
+import {
+  ChristmasCrystals,
+  ChristmasFooterMessage,
+  ChristmasHat,
+  ChristmasHeaderLights,
+  SnowfallEffect,
+} from "@/components/christmas-theme";
+import {
+  SeasonCountdown,
+  SeasonEffects,
+  SeasonFooter,
+  SeasonHeader,
+  SeasonLogo,
+} from "@/components/season-effects";
+import { useSeasonClock } from "@/components/season-clock";
+import { WhatsAppIcon } from "@/components/shop";
+import {
+  activeTheme,
+  christmasSettings,
+  formatThemeDate,
+  migrateEngine,
+  parseThemeDate,
+  scheduleError,
+  THEMES,
+  THEME_IDS,
+  type ThemeEngine,
+  type ThemeId,
+  type ThemeProfile,
+} from "@/lib/theme-engine";
+import { saveSeason, settingsQuery } from "@/lib/settings";
+
+const icons = { christmas: Snowflake, halloween: MoonStar, newyear: Sparkles, cyber: CircuitBoard };
+const fieldClass =
+  "mt-1 block w-full min-w-0 rounded-lg border border-input bg-secondary px-3 py-2 text-sm [color-scheme:dark]";
+
+export function SeasonalThemeSettings() {
+  const query = useQuery(settingsQuery);
+  const client = useQueryClient();
+  const [base, setBase] = useState<ThemeEngine>();
+  const [draft, setDraft] = useState<ThemeEngine>();
+  const [editing, setEditing] = useState<ThemeId>();
+  const [preview, setPreview] = useState<ThemeId | "original">();
+  const [saving, setSaving] = useState(false);
+  const [status, setStatus] = useState("");
+  const [error, setError] = useState("");
+  const saved = query.data?.season ?? DEFAULT_ENGINE;
+  const engine = draft ?? saved;
+  const now = useSeasonClock(saved, !!query.data && !query.isError);
+  const current = saved.manual ?? (now === undefined ? null : activeTheme(saved, now));
+  const conflict = scheduleError(engine);
+  const unavailable = saving || query.isPending || query.isError;
+
+  function change(id: ThemeId, patch: Partial<ThemeProfile>) {
+    setBase(base ?? saved);
+    setDraft({
+      ...engine,
+      profiles: { ...engine.profiles, [id]: { ...engine.profiles[id], ...patch } },
+    });
+    setStatus("");
+    setError("");
+  }
+
+  async function save(next: ThemeEngine, message: string) {
+    const invalid = scheduleError(next);
+    if (invalid) {
+      setError(invalid);
+      return;
+    }
+    if (next.profiles.newyear.effects.countdown && !next.profiles.newyear.countdown) {
+      setError("Defina o horário da contagem regressiva de Midnight.");
+      return;
+    }
+    setSaving(true);
+    setStatus("");
+    setError("");
+    try {
+      await saveSeason(next, base ?? saved);
+      client.setQueryData(
+        settingsQuery.queryKey,
+        (previous) => previous && { ...previous, season: next },
+      );
+      setDraft(undefined);
+      setBase(undefined);
+      setStatus(message);
+      void client.invalidateQueries({ queryKey: settingsQuery.queryKey });
+    } catch (cause) {
+      setError(
+        cause instanceof Error
+          ? cause.message
+          : "Não foi possível salvar. Confira a conexão e as permissões da sua conta.",
+      );
+    } finally {
+      setSaving(false);
+    }
+  }
+
+  return (
+    <section
+      className="rounded-2xl border border-violet-300/20 bg-gradient-to-br from-violet-400/10 to-background p-5 sm:p-6"
+      aria-labelledby="seasons-heading"
+    >
+      <div className="flex flex-wrap items-start justify-between gap-3">
+        <div>
+          <p className="text-xs text-muted-foreground">Aparência sazonal</p>
+          <h2 id="seasons-heading" className="font-display text-xl font-bold">
+            CRAZY SEASONS 2.0
+          </h2>
+          <p className="text-sm text-violet-200">Theme Control</p>
+        </div>
+        <div className="text-sm text-muted-foreground">
+          {current ? `Tema ativo · ${THEMES[current].name}` : "Aparência original"}
+          {saved.pauseSchedule && <p>Agenda pausada</p>}
+        </div>
+      </div>
+      {query.isPending && (
+        <p role="status" className="mt-4 text-sm">
+          Carregando configuração…
+        </p>
+      )}
+      {query.isError && (
+        <p role="alert" className="mt-4 text-sm text-red-300">
+          Configuração indisponível.{" "}
+          <button type="button" className="underline" onClick={() => void query.refetch()}>
+            Tentar novamente
+          </button>
+        </p>
+      )}
+      <div className="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
+        <article className="overflow-hidden rounded-xl border border-border bg-background">
+          <div className="season-card-art grid h-20 place-items-center">
+            <Circle className="size-7" aria-hidden="true" />
+          </div>
+          <div className="space-y-2 p-3">
+            <h3 className="font-semibold">Original</h3>
+            <p className="text-xs text-muted-foreground">Identidade padrão da loja.</p>
+            <div className="flex flex-wrap gap-2">
+              <Button
+                type="button"
+                variant="outline"
+                size="sm"
+                onClick={() => setPreview("original")}
+              >
+                Pré-visualizar
+              </Button>
+              <Button
+                type="button"
+                variant="ghost"
+                size="sm"
+                disabled={unavailable}
+                onClick={() =>
+                  void save(
+                    { ...saved, manual: null, pauseSchedule: true },
+                    "Aparência original restaurada. Agenda pausada.",
+                  )
+                }
+              >
+                Restaurar original
+              </Button>
+            </div>
+          </div>
+        </article>
+        {THEME_IDS.map((id) => {
+          const { name, event, caption } = THEMES[id];
+          const Icon = icons[id];
+          return (
+            <article
+              key={id}
+              className="overflow-hidden rounded-xl border border-border bg-background"
+            >
+              <div data-season={id} className="season-card-art grid h-20 place-items-center">
+                <Icon className="size-8" aria-hidden="true" />
+              </div>
+              <div className="space-y-2 p-3">
+                <div className="flex items-center justify-between gap-2">
+                  <h3 className="font-semibold">{name}</h3>
+                  <span className="text-xs text-violet-200">
+                    {current === id
+                      ? "Ativo"
+                      : saved.profiles[id].scheduled
+                        ? "Programado"
+                        : "Inativo"}
+                  </span>
+                </div>
+                <p className="text-xs text-muted-foreground">
+                  {event} · {caption}
+                </p>
+                <div className="flex flex-wrap gap-2">
+                  <Button type="button" variant="outline" size="sm" onClick={() => setPreview(id)}>
+                    Pré-visualizar
+                  </Button>
+                  <Button
+                    type="button"
+                    variant="ghost"
+                    size="sm"
+                    aria-expanded={editing === id}
+                    aria-controls="season-editor"
+                    onClick={() => setEditing(editing === id ? undefined : id)}
+                  >
+                    Personalizar
+                  </Button>
+                  <Button
+                    type="button"
+                    size="sm"
+                    disabled={unavailable || !!conflict}
+                    onClick={() => void save({ ...engine, manual: id }, `${name} ativado.`)}
+                  >
+                    Ativar agora
+                  </Button>
+                </div>
+              </div>
+            </article>
+          );
+        })}
+      </div>
+
+      {editing && (
+        <fieldset
+          id="season-editor"
+          className="mt-5 rounded-xl border border-border p-4"
+          disabled={unavailable}
+        >
+          <legend className="px-2 font-semibold">{THEMES[editing].name}</legend>
+          <div className="grid gap-3 sm:grid-cols-2">
+            {Object.entries(THEMES[editing].effects).map(([key, label]) => (
+              <label
+                key={key}
+                className="flex items-center justify-between gap-3 rounded-lg border border-border px-3 py-2 text-sm"
+              >
+                {label}
+                <Switch
+                  checked={!!engine.profiles[editing].effects[key as keyof ThemeProfile["effects"]]}
+                  onCheckedChange={(value) =>
+                    change(editing, {
+                      effects: { ...engine.profiles[editing].effects, [key]: value },
+                    })
+                  }
+                />
+              </label>
+            ))}
+            <label className="text-sm">
+              Intensidade
+              <select
+                className={fieldClass}
+                value={engine.profiles[editing].intensity}
+                onChange={(event) =>
+                  change(editing, { intensity: event.target.value as ThemeProfile["intensity"] })
+                }
+              >
+                <option value="soft">Suave</option>
+                <option value="medium">Média</option>
+                <option value="strong">Intensa</option>
+              </select>
+            </label>
+            <label className="flex items-center justify-between gap-3 rounded-lg border border-border px-3 py-2 text-sm">
+              Agendar ativação{" "}
+              <Switch
+                checked={engine.profiles[editing].scheduled}
+                onCheckedChange={(scheduled) => change(editing, { scheduled })}
+              />
+            </label>
+            {(
+              [
+                "start",
+                "end",
+                ...(editing === "newyear" && engine.profiles.newyear.effects.countdown
+                  ? ["countdown"]
+                  : []),
+              ] as const
+            ).map((field) => {
+              const key = field as "start" | "end" | "countdown";
+              return (
+                <label key={key} className="min-w-0 text-sm">
+                  {{ start: "Início", end: "Término", countdown: "Horário da virada" }[key]}
+                  <input
+                    className={fieldClass}
+                    type="datetime-local"
+                    value={formatThemeDate(engine.profiles[editing][key])}
+                    onChange={(event) => {
+                      try {
+                        change(editing, { [key]: parseThemeDate(event.target.value) });
+                      } catch (cause) {
+                        setError(cause instanceof Error ? cause.message : "Horário inválido.");
+                      }
+                    }}
+                  />
+                </label>
+              );
+            })}
+          </div>
+          <p className="mt-3 text-xs text-muted-foreground">
+            Horário de Brasília (America/Sao_Paulo). Um tema ativo manualmente tem prioridade sobre
+            os agendados.
+          </p>
+        </fieldset>
+      )}
+      {conflict && (
+        <p role="alert" className="mt-3 text-sm text-red-300">
+          {conflict}
+        </p>
+      )}
+      {error && (
+        <p role="alert" className="mt-3 text-sm text-red-300">
+          {error}
+        </p>
+      )}
+      {status && (
+        <p role="status" className="mt-3 text-sm text-violet-200">
+          {status}
+        </p>
+      )}
+      <div className="mt-4 flex flex-wrap gap-2">
+        <Button
+          type="button"
+          disabled={unavailable || !draft || !!conflict}
+          onClick={() => void save(engine, "Configurações salvas.")}
+        >
+          {saving ? "Salvando…" : "Salvar configurações"}
+        </Button>
+        <Button
+          type="button"
+          variant="outline"
+          disabled={unavailable || !!conflict}
+          onClick={() =>
+            void save(
+              { ...engine, manual: null, pauseSchedule: false },
+              "Agenda automática em uso.",
+            )
+          }
+        >
+          Usar agenda automática
+        </Button>
+        {draft && (
+          <Button
+            type="button"
+            variant="ghost"
+            disabled={saving}
+            onClick={() => {
+              setDraft(undefined);
+              setBase(undefined);
+              setError("");
+            }}
+          >
