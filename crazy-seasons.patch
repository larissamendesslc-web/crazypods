@@ -0,0 +1,123 @@
+import { useEffect, useId, useState, type CSSProperties } from "react";
+import { Snowflake, Sparkles } from "lucide-react";
+import { seasonIsActive, type SeasonSettings } from "@/lib/seasons";
+import "./christmas-theme.css";
+
+const snowCount = { soft: 20, medium: 34, strong: 52 };
+
+export function useChristmasTheme(season: SeasonSettings, available: boolean) {
+  const [now, setNow] = useState<number>();
+  useEffect(() => {
+    let timer: ReturnType<typeof setTimeout>;
+    function syncClock() {
+      clearTimeout(timer);
+      const time = Date.now();
+      setNow(time);
+      const next = [season.start, season.end]
+        .map((date) => (date ? Date.parse(date) : Infinity))
+        .filter((date) => date > time);
+      if (next.length)
+        timer = setTimeout(syncClock, Math.min(2_147_483_647, Math.min(...next) - time));
+    }
+    syncClock();
+    document.addEventListener("visibilitychange", syncClock);
+    return () => {
+      clearTimeout(timer);
+      document.removeEventListener("visibilitychange", syncClock);
+    };
+  }, [season.start, season.end]);
+  return available && now !== undefined && seasonIsActive(season, now);
+}
+
+export function SnowfallEffect({ intensity }: { intensity: SeasonSettings["snow"] }) {
+  const [visible, setVisible] = useState(true);
+  useEffect(() => {
+    const sync = () => setVisible(!document.hidden);
+    sync();
+    document.addEventListener("visibilitychange", sync);
+    return () => document.removeEventListener("visibilitychange", sync);
+  }, []);
+
+  return (
+    <div aria-hidden="true" className="black-ice-snow" data-paused={!visible}>
+      {Array.from({ length: snowCount[intensity] }, (_, index) => {
+        const unit = ((index * 67) % 101) / 100;
+        const duration = 8 + unit * 14;
+        return (
+          <i
+            key={index}
+            style={
+              {
+                "--snow-x": `${(index * 37 + 8) % 101}%`,
+                "--snow-size": `${1.5 + unit * 4}px`,
+                "--snow-drift": `${(index % 2 ? 1 : -1) * (13 + 34 * unit)}px`,
+                "--snow-opacity": 0.2 + unit * 0.62,
+                "--snow-duration": `${duration}s`,
+                "--snow-delay": `-${(duration * ((index * 53) % 97)) / 97}s`,
+              } as CSSProperties
+            }
+          />
+        );
+      })}
+    </div>
+  );
+}
+
+export function ChristmasHat({ target }: { target: "whatsapp" | "logo" }) {
+  const gradient = useId();
+  return (
+    <svg
+      className={`black-ice-hat black-ice-hat--${target}`}
+      aria-hidden="true"
+      focusable="false"
+      viewBox="0 0 60 45"
+    >
+      <defs>
+        <linearGradient id={gradient} x2="1" y2="1">
+          <stop stopColor="#f4edff" />
+          <stop offset=".32" stopColor="#ab96da" />
+          <stop offset="1" stopColor="#4b376d" />
+        </linearGradient>
+      </defs>
+      <path
+        d="M11 32C18 25 17 10 28 6s19 4 22 14l-9 2-7-4 6 15Z"
+        fill={`url(#${gradient})`}
+        stroke="#ded8f4"
+      />
+      <path
+        d="M12 30c10-3 20-4 28 0 3 2 4 7 0 9-8-2-18-2-27 1-5-1-6-7-1-10Z"
+        fill="#f4f3fa"
+        stroke="#b5adcc"
+      />
+      <circle cx="49" cy="21" r="6" fill="#f4f3fa" stroke="#b5adcc" />
+    </svg>
+  );
+}
+
+export function ChristmasHeaderLights() {
+  return (
+    <div className="black-ice-lights" aria-hidden="true">
+      {Array.from({ length: 32 }, (_, index) => (
+        <i key={index} />
+      ))}
+    </div>
+  );
+}
+
+export function ChristmasCrystals() {
+  return (
+    <span aria-hidden="true" className="black-ice-crystals">
+      <Snowflake />
+      <Sparkles />
+      <Snowflake />
+    </span>
+  );
+}
+
+export function ChristmasFooterMessage() {
+  return (
+    <p className="black-ice-greeting">
+      <Snowflake aria-hidden="true" /> Boas festas, da equipe Crazy Pods.
+    </p>
+  );
+}
