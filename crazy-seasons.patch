@@ -0,0 +1,105 @@
+import { useEffect, useId, useState, type CSSProperties } from "react";
+import { Snowflake, Sparkles } from "lucide-react";
+import type { SeasonSettings } from "@/lib/seasons";
+import "./christmas-theme.css";
+
+function useTabVisibility() {
+  const [visible, setVisible] = useState(true);
+  useEffect(() => {
+    const sync = () => setVisible(!document.hidden);
+    sync();
+    document.addEventListener("visibilitychange", sync);
+    return () => document.removeEventListener("visibilitychange", sync);
+  }, []);
+  return visible;
+}
+
+const snowCount = { soft: 20, medium: 34, strong: 52 };
+
+export function SnowfallEffect({ intensity }: { intensity: SeasonSettings["snow"] }) {
+  const visible = useTabVisibility();
+
+  return (
+    <div aria-hidden="true" className="black-ice-snow" data-paused={!visible}>
+      {Array.from({ length: snowCount[intensity] }, (_, index) => {
+        const unit = ((index * 67) % 101) / 100;
+        const duration = 8 + unit * 14;
+        return (
+          <i
+            key={index}
+            style={
+              {
+                "--snow-x": `${(index * 37 + 8) % 101}%`,
+                "--snow-size": `${1.5 + unit * 4}px`,
+                "--snow-drift": `${(index % 2 ? 1 : -1) * (13 + 34 * unit)}px`,
+                "--snow-opacity": 0.2 + unit * 0.62,
+                "--snow-duration": `${duration}s`,
+                "--snow-delay": `-${(duration * ((index * 53) % 97)) / 97}s`,
+              } as CSSProperties
+            }
+          />
+        );
+      })}
+    </div>
+  );
+}
+
+export function ChristmasHat({ target }: { target: "whatsapp" | "logo" }) {
+  const gradient = useId();
+  return (
+    <svg
+      className={`black-ice-hat black-ice-hat--${target}`}
+      aria-hidden="true"
+      focusable="false"
+      viewBox="0 0 60 45"
+    >
+      <defs>
+        <linearGradient id={gradient} x2="1" y2="1">
+          <stop stopColor="#f4edff" />
+          <stop offset=".32" stopColor="#ab96da" />
+          <stop offset="1" stopColor="#4b376d" />
+        </linearGradient>
+      </defs>
+      <path
+        d="M11 32C18 25 17 10 28 6s19 4 22 14l-9 2-7-4 6 15Z"
+        fill={`url(#${gradient})`}
+        stroke="#ded8f4"
+      />
+      <path
+        d="M12 30c10-3 20-4 28 0 3 2 4 7 0 9-8-2-18-2-27 1-5-1-6-7-1-10Z"
+        fill="#f4f3fa"
+        stroke="#b5adcc"
+      />
+      <circle cx="49" cy="21" r="6" fill="#f4f3fa" stroke="#b5adcc" />
+    </svg>
+  );
+}
+
+export function ChristmasHeaderLights() {
+  const visible = useTabVisibility();
+  return (
+    <div className="black-ice-lights" data-paused={!visible} aria-hidden="true">
+      {Array.from({ length: 32 }, (_, index) => (
+        <i key={index} />
+      ))}
+    </div>
+  );
+}
+
+export function ChristmasCrystals() {
+  return (
+    <span aria-hidden="true" className="black-ice-crystals">
+      <Snowflake />
+      <Sparkles />
+      <Snowflake />
+    </span>
+  );
+}
+
+export function ChristmasFooterMessage() {
+  return (
+    <p className="black-ice-greeting">
+      <Snowflake aria-hidden="true" /> Boas festas, da equipe Crazy Pods.
+    </p>
+  );
+}
diff --git a/src/components/season-clock.ts b/src/components/season-clock.ts
new file mode 100644
index 0000000..259607d
--- /dev/null
+++ b/src/components/season-clock.ts
@@ -0,0 +1,48 @@
+import { useEffect, useState } from "react";
+import { useQuery } from "@tanstack/react-query";
+import { THEME_IDS, type ThemeEngine } from "@/lib/theme-engine";
+
+export function useSeasonClock(engine: ThemeEngine, available: boolean) {
+  const clock = useQuery({
+    queryKey: ["seasons-clock"],
+    enabled: available && typeof window !== "undefined",
+    staleTime: 60_000,
+    refetchInterval: 300_000,
+    queryFn: async ({ signal }) => {
+      const start = performance.now();
+      const response = await fetch("/api/seasons-clock", { cache: "no-store", signal });
+      if (!response.ok) throw new Error("Horário indisponível.");
+      const { now } = await response.json();
+      if (!Number.isFinite(now)) throw new Error("Horário inválido.");
+      const received = performance.now();
+      return { now: Number(now) + (received - start) / 2, received };
+    },
+  });
+  const [now, setNow] = useState<number>();
+  useEffect(() => {
+    if (!clock.data || !available) return;
+    const anchor = clock.data;
+    const boundaries = THEME_IDS.flatMap((id) => {
+      const profile = engine.profiles[id];
+      return profile.scheduled ? [profile.start, profile.end] : [];
+    }).map((value) => (value ? Date.parse(value) : Infinity));
+    let timer: ReturnType<typeof setTimeout>;
+    function sync() {
+      clearTimeout(timer);
+      const current = anchor.now + performance.now() - anchor.received;
+      setNow(current);
+      if (document.hidden) return;
+      const next = Math.min(...boundaries.filter((time) => time > current));
+      const delay = next - current;
+      if (Number.isFinite(delay))
+        timer = setTimeout(sync, Math.min(2_147_483_647, Math.ceil(delay)));
+    }
+    sync();
+    document.addEventListener("visibilitychange", sync);
+    return () => {
+      clearTimeout(timer);
+      document.removeEventListener("visibilitychange", sync);
+    };
+  }, [available, clock.data, engine]);
+  return available ? now : undefined;
+}
