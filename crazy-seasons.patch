+// The Vercel preview can save and exercise scheduling without sharing the live theme.
+const seasonKey =
+  import.meta.env["VITE_CRAZY_SEASONS_PREVIEW"] === "1" ? "crazy_seasons_preview" : "crazy_seasons";
+
+const engineKey = `${seasonKey}_v2`;
+
+function settingsObject(value: Json | undefined): Record<string, Json | undefined> {
+  return value && typeof value === "object" && !Array.isArray(value) ? value : {};
+}
+
+async function readSettings() {
+  const { data, error } = await supabase
+    .from("site_settings")
+    .select("data, updated_at")
+    .eq("id", 1)
+    .maybeSingle();
