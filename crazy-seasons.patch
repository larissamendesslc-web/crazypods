@@ -0,0 +1,83 @@
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { cleanup, fireEvent, render, screen, waitFor, within } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { migrateEngine, type ThemeEngine } from "@/lib/theme-engine";
+
+const persistence = vi.hoisted(() => ({ read: vi.fn(), save: vi.fn() }));
+vi.mock("@/lib/settings", () => ({
+  settingsQuery: { queryKey: ["site_settings"], queryFn: persistence.read },
+  saveSeason: persistence.save,
+}));
+vi.mock("@/components/season-clock", () => ({
+  useSeasonClock: () => Date.parse("2026-11-14T00:00:00Z"),
+}));
+vi.mock("@/components/shop", () => ({ WhatsAppIcon: () => null }));
+
+import { SeasonalThemeSettings } from "./seasonal-theme-settings";
+
+function openPanel() {
+  const queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  return render(
+    <QueryClientProvider client={queryClient}>
+      <SeasonalThemeSettings />
+    </QueryClientProvider>,
+  );
+}
+
+let stored: ThemeEngine;
+beforeEach(() => {
+  stored = migrateEngine(undefined);
+  persistence.read.mockReset().mockImplementation(async () => ({ season: stored }));
+  persistence.save.mockReset().mockImplementation(async (value) => {
+    stored = value;
+  });
+});
+afterEach(cleanup);
+
+function card(name: string) {
+  const article = screen.getByRole("heading", { name }).closest("article");
+  if (!article) throw new Error("Cartão ausente.");
+  return within(article);
+}
+
+describe("Aparência sazonal", () => {
+  it("previews, activates, reloads and restores the original", async () => {
+    const panel = openPanel();
+    const christmas = card("Black Ice");
+    const enable = christmas.getByRole("button", { name: "Ativar agora" });
+    await waitFor(() => expect(enable).toBeEnabled());
+    fireEvent.click(christmas.getByRole("button", { name: "Personalizar" }));
+    fireEvent.change(screen.getByLabelText("Intensidade"), { target: { value: "medium" } });
+    fireEvent.click(christmas.getByRole("button", { name: "Pré-visualizar" }));
+    expect(await screen.findByRole("dialog", { name: "Prévia · Black Ice" })).toBeVisible();
+    expect(screen.getByText("Boas festas, da equipe Crazy Pods.")).toBeVisible();
+    expect(persistence.save).not.toHaveBeenCalled();
+    fireEvent.keyDown(document.activeElement!, { key: "Escape" });
+    fireEvent.click(enable);
+    expect(await screen.findByText("Black Ice ativado.")).toBeVisible();
+    expect(stored.manual).toBe("christmas");
+    expect(stored.profiles.christmas.intensity).toBe("medium");
+    panel.unmount();
+
+    openPanel();
+    expect(await screen.findByText("Tema ativo · Black Ice")).toBeVisible();
+    fireEvent.click(screen.getByRole("button", { name: "Restaurar original" }));
+    expect(await screen.findByText(/Aparência original restaurada/)).toBeVisible();
+    expect(stored).toMatchObject({ manual: null, pauseSchedule: true });
+    expect(stored.profiles.christmas.intensity).toBe("medium");
+  });
+
+  it("reports a denied write and keeps the draft available", async () => {
+    persistence.save.mockRejectedValueOnce({ code: "42501" });
+    openPanel();
+    const halloween = card("Dark Ritual");
+    const enable = halloween.getByRole("button", { name: "Ativar agora" });
+    await waitFor(() => expect(enable).toBeEnabled());
+    fireEvent.click(halloween.getByRole("button", { name: "Personalizar" }));
+    fireEvent.click(screen.getByRole("switch", { name: "Névoa" }));
+    fireEvent.click(enable);
+    expect(await screen.findByRole("alert")).toHaveTextContent("Não foi possível salvar.");
+    expect(screen.getByRole("switch", { name: "Névoa" })).not.toBeChecked();
+    expect(stored.manual).toBeNull();
+  });
+});
