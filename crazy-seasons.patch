+}
+@media (max-width: 640px), (pointer: coarse) {
+  .season-particles i:nth-child(2n),
+  .season-fireworks svg + svg {
+    display: none;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .season-effects * {
+    animation: none;
+  }
+  .season-particles,
+  .season-bat,
+  .season-fireworks,
+  .season-energy {
+    display: none;
+  }
+}
