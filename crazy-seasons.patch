+          className="absolute bottom-3 right-4 grid size-11 place-items-center rounded-full bg-whatsapp text-white"
+        >
+          <WhatsAppIcon className="size-5" />
+          {christmas && ice.whatsappHat && <ChristmasHat target="whatsapp" />}
+        </span>
+        {id === "newyear" && p?.effects.countdown && p.countdown && now !== undefined && (
+          <SeasonCountdown now={now} target={p.countdown} />
+        )}
+      </div>
+      <footer className="relative h-10">
+        {christmas && ice.trim && <ChristmasFooterMessage />}
+        {id !== "original" &&
+          !christmas &&
+          (p?.effects.trim || (id === "cyber" && p?.effects.lights)) && <SeasonFooter id={id} />}
+      </footer>
+      {christmas && p?.effects.snow && <SnowfallEffect intensity={ice.snow} />}
+      {id !== "original" && !christmas && p && <SeasonEffects id={id} profile={p} embedded />}
+    </div>
+  );
+}
