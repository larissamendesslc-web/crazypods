diff --git a/src/lib/seasons.test.ts b/src/lib/seasons.test.ts
new file mode 100644
index 0000000..f746efc
--- /dev/null
+++ b/src/lib/seasons.test.ts
@@ -0,0 +1,36 @@
+import { describe, expect, it } from "vitest";
+import {
+  DEFAULT_SEASON,
+  fromLocalSchedule,
+  readSeason,
+  seasonIsActive,
+  toLocalSchedule,
+} from "./seasons";
+
+describe("Crazy Seasons", () => {
+  it("uses the original appearance for missing and invalid configuration", () => {
+    expect(readSeason(undefined)).toEqual(DEFAULT_SEASON);
+    expect(readSeason({ enabled: true, snow: "broken" })).toEqual(DEFAULT_SEASON);
+    expect(
+      readSeason({ enabled: true, start: "2026-12-24T00:00:00Z", end: "2026-12-23T00:00:00Z" }),
+    ).toEqual(DEFAULT_SEASON);
+  });
+
+  it("includes the scheduled start and excludes the end", () => {
+    const start = "2026-12-24T03:00:00Z";
+    const end = "2026-12-26T03:00:00Z";
+    const config = readSeason({ enabled: true, start, end });
+    expect(seasonIsActive(config, Date.parse(start) - 1)).toBe(false);
+    expect(seasonIsActive(config, Date.parse(start))).toBe(true);
+    expect(seasonIsActive(config, Date.parse(end) - 1)).toBe(true);
+    expect(seasonIsActive(config, Date.parse(end))).toBe(false);
+    expect(seasonIsActive({ ...config, enabled: false }, Date.parse(start))).toBe(false);
+  });
+
+  it("stores Brasília dates in UTC and displays them in Brasília", () => {
+    const local = "2026-12-24T00:00";
+    expect(fromLocalSchedule(local)).toBe("2026-12-24T03:00:00.000Z");
+    expect(toLocalSchedule(fromLocalSchedule(local))).toBe(local);
+    expect(fromLocalSchedule("")).toBeNull();
+  });
+});
diff --git a/src/lib/seasons.ts b/src/lib/seasons.ts
new file mode 100644
index 0000000..0d6b4f2
--- /dev/null
+++ b/src/lib/seasons.ts
@@ -0,0 +1,53 @@
+import { z } from "zod";
+
+export const SNOW_LEVELS = ["soft", "medium", "strong"] as const;
+export const SAO_PAULO_OFFSET = "-03:00";
+
+const seasonSchema = z
+  .object({
+    enabled: z.boolean(),
+    snow: z.enum(SNOW_LEVELS),
+    whatsappHat: z.boolean(),
+    logoHat: z.boolean(),
+    lights: z.boolean(),
+    trim: z.boolean(),
+    start: z.string().datetime().nullable(),
+    end: z.string().datetime().nullable(),
+  })
+  .refine(({ start, end }) => !start || !end || Date.parse(start) < Date.parse(end));
+
+export type SeasonSettings = z.infer<typeof seasonSchema>;
+
+export const DEFAULT_SEASON: SeasonSettings = {
+  enabled: false,
+  snow: "soft",
+  whatsappHat: true,
+  logoHat: true,
+  lights: true,
+  trim: true,
+  start: null,
+  end: null,
+};
+
+export function readSeason(value: unknown): SeasonSettings {
+  if (!value || typeof value !== "object") return DEFAULT_SEASON;
+  const parsed = seasonSchema.safeParse({ ...DEFAULT_SEASON, ...value });
+  return parsed.success ? parsed.data : DEFAULT_SEASON;
+}
+
+export function seasonIsActive(season: SeasonSettings, now: number) {
+  return (
+    season.enabled &&
+    (!season.start || now >= Date.parse(season.start)) &&
+    (!season.end || now < Date.parse(season.end))
+  );
+}
+
+export function fromLocalSchedule(value: string) {
+  if (!value) return null;
+  return new Date(`${value}:00${SAO_PAULO_OFFSET}`).toISOString();
+}
+
+export function toLocalSchedule(value: string | null) {
+  return value ? new Date(Date.parse(value) - 3 * 3600000).toISOString().slice(0, 16) : "";
+}
