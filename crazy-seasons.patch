@@ -0,0 +1,225 @@
+import { z } from "zod";
+import { DEFAULT_SEASON, readSeason, SNOW_LEVELS, type SeasonSettings } from "./seasons";
+
+export const THEMES = {
+  christmas: {
+    name: "Black Ice",
+    event: "Natal",
+    caption: "Neve, prata e luzes frias.",
+    effects: {
+      snow: "Neve",
+      whatsappHat: "Gorro do WhatsApp",
+      logoHat: "Gorro da logo",
+      lights: "Luzes natalinas",
+      trim: "Cristais e rodapé",
+    },
+  },
+  halloween: {
+    name: "Dark Ritual",
+    event: "Halloween",
+    caption: "Névoa violeta, âmbar e sombras.",
+    effects: {
+      mist: "Névoa",
+      particles: "Partículas",
+      pumpkins: "Abóboras",
+      bats: "Morcegos",
+      lights: "Luz no cabeçalho",
+      logo: "Detalhe na logo",
+      trim: "Bordas iluminadas",
+    },
+  },
+  newyear: {
+    name: "Midnight",
+    event: "Ano-Novo",
+    caption: "Prata, ouro e luzes da meia-noite.",
+    effects: {
+      fireworks: "Fogos",
+      particles: "Partículas metálicas",
+      lights: "Luz no cabeçalho",
+      countdown: "Contagem regressiva",
+      glow: "Brilhos",
+      trim: "Rodapé de celebração",
+      logo: "Detalhe na logo",
+    },
+  },
+  cyber: {
+    name: "Black Volt",
+    event: "Cyber Neon",
+    caption: "Circuitos violeta sobre vidro escuro.",
+    effects: {
+      circuits: "Circuitos",
+      energy: "Linhas de energia",
+      particles: "Partículas digitais",
+      glow: "Brilhos de interface",
+      trim: "Bordas dinâmicas",
+      lights: "Cabeçalho e rodapé",
+    },
+  },
+};
+
+export type ThemeId = keyof typeof THEMES;
+export const THEME_IDS = Object.keys(THEMES) as ThemeId[];
+const themeId = z.enum(["christmas", "halloween", "newyear", "cyber"]);
+const instant = z.string().datetime().nullable();
+const profileSchema = z.object({
+  intensity: z.enum(SNOW_LEVELS),
+  effects: z
+    .object({
+      snow: z.boolean(),
+      whatsappHat: z.boolean(),
+      logoHat: z.boolean(),
+      lights: z.boolean(),
+      trim: z.boolean(),
+      mist: z.boolean(),
+      particles: z.boolean(),
+      pumpkins: z.boolean(),
+      bats: z.boolean(),
+      logo: z.boolean(),
+      fireworks: z.boolean(),
+      countdown: z.boolean(),
+      glow: z.boolean(),
+      circuits: z.boolean(),
+      energy: z.boolean(),
+    })
+    .partial(),
+  scheduled: z.boolean(),
+  start: instant,
+  end: instant,
+  countdown: instant,
+});
+export type ThemeProfile = z.infer<typeof profileSchema>;
+const engineSchema = z.object({
+  version: z.literal(2),
+  manual: themeId.nullable(),
+  pauseSchedule: z.boolean(),
+  profiles: z.object({
+    christmas: profileSchema,
+    halloween: profileSchema,
+    newyear: profileSchema,
+    cyber: profileSchema,
+  }),
+});
+export type ThemeEngine = z.infer<typeof engineSchema>;
+
+export function defaultProfile(id: ThemeId): ThemeProfile {
+  return {
+    intensity: "soft",
+    effects: Object.fromEntries(
+      Object.keys(THEMES[id].effects).map((effect) => [effect, effect !== "countdown"]),
+    ),
+    scheduled: false,
+    start: null,
+    end: null,
+    countdown: null,
+  };
+}
+
+export function migrateEngine(legacy: unknown): ThemeEngine {
+  const { enabled, snow, start, end, ...effects } = readSeason(legacy);
+  return {
+    version: 2,
+    manual: enabled && !start && !end ? "christmas" : null,
+    pauseSchedule: false,
+    profiles: {
+      christmas: {
+        ...defaultProfile("christmas"),
+        intensity: snow,
+        start,
+        end,
+        effects: { snow: true, ...effects },
+        scheduled: enabled && !!(start || end),
+      },
+      halloween: defaultProfile("halloween"),
+      newyear: defaultProfile("newyear"),
+      cyber: defaultProfile("cyber"),
+    },
+  };
+}
+
+export function readEngine(value: unknown, legacy: unknown): ThemeEngine {
+  if (value == null) return migrateEngine(legacy);
+  const parsed = engineSchema.safeParse(value);
+  if (!parsed.success || scheduleError(parsed.data)) return migrateEngine(undefined);
+  for (const id of THEME_IDS) {
+    const effects: Record<string, boolean | undefined> = parsed.data.profiles[id].effects;
+    parsed.data.profiles[id].effects = Object.fromEntries(
+      Object.entries(defaultProfile(id).effects).map(([key, fallback]) => [
+        key,
+        effects[key] ?? fallback,
+      ]),
+    );
+  }
+  return parsed.data;
+}
+
+export function christmasSettings(engine: ThemeEngine): SeasonSettings {
+  const { intensity, effects } = engine.profiles.christmas;
+  return {
+    ...DEFAULT_SEASON,
+    snow: intensity,
+    whatsappHat: !!effects.whatsappHat,
+    logoHat: !!effects.logoHat,
+    lights: !!effects.lights,
+    trim: !!effects.trim,
+  };
+}
+
+const startOf = (p: ThemeProfile) => (p.start ? Date.parse(p.start) : -Infinity);
+const endOf = (p: ThemeProfile) => (p.end ? Date.parse(p.end) : Infinity);
+
+export function scheduleError(engine: ThemeEngine): string | undefined {
+  const entries = THEME_IDS.filter((id) => engine.profiles[id].scheduled);
+  for (const [index, id] of entries.entries()) {
+    const profile = engine.profiles[id];
+    if (!profile.start && !profile.end) return `Informe início ou término para ${THEMES[id].name}.`;
+    if (startOf(profile) >= endOf(profile))
+      return `O término de ${THEMES[id].name} precisa ser posterior ao início.`;
+    const overlap = entries.slice(index + 1).find((other) => {
+      const candidate = engine.profiles[other];
+      return startOf(profile) < endOf(candidate) && startOf(candidate) < endOf(profile);
+    });
+    if (overlap) return `Os períodos de ${THEMES[id].name} e ${THEMES[overlap].name} se sobrepõem.`;
+  }
+  return undefined;
+}
+
+export function activeTheme(engine: ThemeEngine, now: number): ThemeId | null {
+  if (engine.manual) return engine.manual;
+  if (engine.pauseSchedule) return null;
+  return (
+    THEME_IDS.find((id) => {
+      const p = engine.profiles[id];
+      return p.scheduled && now >= startOf(p) && now < endOf(p);
+    }) ?? null
+  );
+}
+
+export const SEASON_ZONE = "America/Sao_Paulo";
+const localFormat = new Intl.DateTimeFormat("sv-SE", {
+  timeZone: SEASON_ZONE,
+  year: "numeric",
+  month: "2-digit",
+  day: "2-digit",
+  hour: "2-digit",
+  minute: "2-digit",
+  hourCycle: "h23",
+});
+
+export function formatThemeDate(instant: string | null) {
+  if (!instant) return "";
+  const parts = Object.fromEntries(
+    localFormat.formatToParts(new Date(instant)).map(({ type, value }) => [type, value]),
+  );
+  return `${parts["year"]}-${parts["month"]}-${parts["day"]}T${parts["hour"]}:${parts["minute"]}`;
+}
+
+export function parseThemeDate(local: string): string | null {
+  if (!local) return null;
+  const target = Date.parse(`${local}:00Z`);
+  if (!Number.isFinite(target)) throw new Error("Data inválida.");
+  const candidates = [-4, -3, -2]
+    .map((offset) => new Date(target - offset * 3_600_000).toISOString())
+    .filter((value) => formatThemeDate(value) === local);
+  if (candidates.length !== 1) throw new Error("Horário inválido ou ambíguo em America/Sao_Paulo.");
+  return candidates[0]!;
+}
