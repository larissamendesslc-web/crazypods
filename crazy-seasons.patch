@@ -0,0 +1,172 @@
+import { useEffect, useState, type CSSProperties } from "react";
+import { CircuitBoard, MoonStar, Sparkles } from "lucide-react";
+import { type ThemeId, type ThemeProfile } from "@/lib/theme-engine";
+import "./season-effects.css";
+
+const count = { soft: 12, medium: 22, strong: 32 };
+
+function Pumpkin() {
+  return (
+    <svg viewBox="0 0 76 64" focusable="false" aria-hidden="true">
+      <path d="M37 18c-2-7 2-12 7-13" fill="none" stroke="#b87bf4" strokeWidth="3" />
+      <path
+        d="M38 18C11 6 3 34 12 49c6 10 16 11 26 8 10 3 20 2 26-8C73 34 65 6 38 18Z"
+        fill="#291831"
+        stroke="#c77753"
+      />
+      <path d="M38 19c-14 0-17 26-8 37m8-37c14 0 17 26 8 37" fill="none" stroke="#a35244" />
+      <path d="m19 37 9-9 6 10Zm23 1 6-10 9 9ZM25 43l8 3 5-2 5 2 8-3-5 7H30Z" fill="#ffab66" />
+    </svg>
+  );
+}
+
+export function SeasonLogo({ id }: { id: ThemeId }) {
+  return (
+    <span className="season-logo" aria-hidden="true">
+      {id === "halloween" ? <MoonStar /> : <Sparkles />}
+    </span>
+  );
+}
+
+export function SeasonHeader() {
+  return <span className="season-header-line" aria-hidden="true" />;
+}
+
+export function SeasonFooter({ id }: { id: ThemeId }) {
+  return (
+    <span className="season-footer-mark" aria-hidden="true">
+      {id === "halloween" ? <Pumpkin /> : id === "newyear" ? <Sparkles /> : <CircuitBoard />}
+    </span>
+  );
+}
+
+export function SeasonCountdown({ target, now }: { target: string; now: number }) {
+  const [remaining, setRemaining] = useState(() =>
+    Math.max(0, Math.ceil((Date.parse(target) - now) / 1000)),
+  );
+  useEffect(() => {
+    const anchor = performance.now();
+    let timer: ReturnType<typeof setTimeout>;
+    function sync() {
+      clearTimeout(timer);
+      const seconds = Math.max(
+        0,
+        Math.ceil((Date.parse(target) - now - (performance.now() - anchor)) / 1000),
+      );
+      setRemaining(seconds);
+      if (seconds && !document.hidden) timer = setTimeout(sync, 1000);
+    }
+    sync();
+    document.addEventListener("visibilitychange", sync);
+    return () => {
+      clearTimeout(timer);
+      document.removeEventListener("visibilitychange", sync);
+    };
+  }, [target, now]);
+  const format = (n: number) => String(n).padStart(2, "0");
+  return (
+    <span className="season-countdown" role="timer" aria-label="Contagem regressiva">
+      {remaining ? (
+        <>
+          <span>Virada em</span>{" "}
+          <time dateTime={target}>
+            {Math.floor(remaining / 86400)}d {format(Math.floor(remaining / 3600) % 24)}:
+            {format(Math.floor(remaining / 60) % 60)}:{format(remaining % 60)}
+          </time>
+        </>
+      ) : (
+        "Feliz Ano-Novo"
+      )}
+    </span>
+  );
+}
+
+export function SeasonEffects({
+  id,
+  profile,
+  embedded = false,
+}: {
+  id: Exclude<ThemeId, "christmas">;
+  profile: ThemeProfile;
+  embedded?: boolean;
+}) {
+  const e = profile.effects;
+  const [hidden, setHidden] = useState(false);
+  useEffect(() => {
+    const sync = () => setHidden(document.hidden);
+    sync();
+    document.addEventListener("visibilitychange", sync);
+    return () => document.removeEventListener("visibilitychange", sync);
+  }, []);
+  return (
+    <div
+      aria-hidden="true"
+      data-season={id}
+      className={`season-effects${embedded ? " season-effects--sample" : ""}`}
+      data-paused={hidden}
+      data-strength={profile.intensity}
+    >
+      {e.mist && <span className="season-mist" />}
+      {e.particles && (
+        <span className="season-particles">
+          {Array.from({ length: count[profile.intensity] }, (_, i) => (
+            <i
+              key={i}
+              style={
+                {
+                  "--x": `${(i * 37 + 5) % 99}%`,
+                  "--y": `${(i * 23 + 12) % 95}%`,
+                  "--d": `-${i * 1.13}s`,
+                  "--size": `${(i % 3) + 2}px`,
+                } as CSSProperties
+              }
+            />
+          ))}
+        </span>
+      )}
+      {e.pumpkins && (
+        <span className="season-pumpkin">
+          <Pumpkin />
+        </span>
+      )}
+      {e.bats && (
+        <span className="season-bat">
+          <svg viewBox="0 0 80 32" focusable="false">
+            <path
+              fill="currentColor"
+              d="M40 27 35 18C28 17 25 8 18 8 9 8 2 14 0 19c8-4 14-1 16 4 8-4 15-1 24 4 9-5 16-8 24-4 2-5 8-8 16-4-2-5-9-11-18-11-7 0-10 9-17 10l-5 9Z"
+            />
+          </svg>
+        </span>
+      )}
+      {e.fireworks && (
+        <span className="season-fireworks">
+          {[0, 1].map((i) => (
+            <svg key={i} viewBox="0 0 80 80" fill="none" stroke="currentColor" focusable="false">
+              <path
+                d="M40 5v21m0 28v21M5 40h21m28 0h21M15 15l14 14m22 22 14 14M15 65l14-14m22-22 14-14M26 6l8 21m12 26 8 21M6 54l21-8m26-12 21-8"
+                strokeWidth="1.5"
+                strokeLinecap="round"
+              />
+              <circle cx="40" cy="40" r="4" fill="currentColor" />
+              <circle cx="40" cy="40" r="17" opacity=".44" strokeDasharray="1 6" />
+            </svg>
+          ))}
+        </span>
+      )}
+      {e.glow && <span className="season-glow" />}
+      {e.circuits && (
+        <svg className="season-circuits" viewBox="0 0 500 210" focusable="false">
+          <path d="M0 20h130l45 45h68m-243-23h107l55 55h54M0 64h72l55 55h66M500 139H386l-37-37h-85m236 59H373l-36-36h-90m253 58H360l-35-35h-60" />
+          <circle cx="243" cy="65" r="4" />
+          <circle cx="216" cy="97" r="4" />
+          <circle cx="193" cy="119" r="4" />
+          <circle cx="264" cy="102" r="4" />
+          <circle cx="247" cy="125" r="4" />
+          <circle cx="265" cy="148" r="4" />
+        </svg>
+      )}
+      {e.energy && <span className="season-energy" />}
+    </div>
+  );
+}
