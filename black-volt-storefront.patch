diff --git a/src/styles.css b/src/styles.css
index 7e28532..9814550 100644
--- a/src/styles.css
+++ b/src/styles.css
@@ -462,3 +462,53 @@ button:focus-visible {
   .floating-cart-launcher:active { transform: none; }
 }
 
+
+/* Black Volt storefront */
+.volt-launches {
+  padding-block: clamp(1.5rem, 4vw, 3.5rem);
+}
+
+.volt-product-card {
+  border-radius: .85rem;
+}
+
+.volt-product-stage.mobile-product-stage {
+  display: grid;
+  height: auto;
+  aspect-ratio: 1 / 1;
+  padding: .9rem .65rem .4rem;
+  place-items: center;
+}
+
+.volt-product-image.mobile-product-image {
+  height: 100%;
+  min-height: 0;
+  max-height: 100%;
+  margin-top: 0;
+  padding: 1rem .25rem .15rem;
+}
+
+.volt-product-name {
+  display: -webkit-box;
+  min-block-size: 2.5em;
+  overflow: hidden;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 2;
+}
+
+.volt-cart-sheet {
+  max-height: 100dvh;
+}
+.volt-cart-scroll {
+  scroll-padding-block: 1rem;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .volt-product-card,
+  .volt-product-image {
+    transition: none;
+  }
+  .volt-product-card:hover {
+    transform: none;
+  }
+}
