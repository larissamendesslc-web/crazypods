diff --git a/src/styles.css b/src/styles.css
index 7e28532..3a96ad7 100644
--- a/src/styles.css
+++ b/src/styles.css
@@ -462,3 +462,210 @@ button:focus-visible {
   .floating-cart-launcher:active { transform: none; }
 }
 
+
+/* Black Volt storefront */
+.volt-launches {
+  padding-block: clamp(1.5rem, 4vw, 3.5rem);
+}
+
+.volt-product-card {
+  border-radius: .85rem;
+}
+
+.volt-product-stage.mobile-product-stage {
+  display: grid;
+  height: auto;
+  aspect-ratio: 1 / 1;
+  padding: .9rem .65rem .4rem;
+  place-items: center;
+}
+
+.volt-product-image.mobile-product-image {
+  height: 100%;
+  min-height: 0;
+  max-height: 100%;
+  margin-top: 0;
+  padding: 1rem .25rem .15rem;
+}
+
+.volt-product-name {
+  display: -webkit-box;
+  min-block-size: 2.5em;
+  overflow: hidden;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 2;
+}
+
+.volt-cart-sheet {
+  max-height: 100dvh;
+}
+.volt-cart-scroll {
+  scroll-padding-block: 1rem;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .volt-product-card,
+  .volt-product-image {
+    transition: none;
+  }
+  .volt-product-card:hover {
+    transform: none;
+  }
+}
+
+/* Crazy Pods campaign and collection */
+.crazy-stage {
+  --stage-rgb: 226 156 60;
+  position: relative;
+  isolation: isolate;
+  overflow: hidden;
+  background: #100e16;
+}
+.crazy-stage[data-tone="violet"] { --stage-rgb: 173 134 255; }
+.crazy-stage[data-tone="mint"] { --stage-rgb: 97 220 194; }
+.crazy-stage[data-tone="blue"] { --stage-rgb: 105 168 255; }
+.crazy-stage[data-tone="coral"] { --stage-rgb: 253 143 145; }
+
+.crazy-stage-frame { max-width: 80rem; padding: 1rem 1.25rem; margin-inline: auto; }
+.crazy-stage-slide {
+  position: relative;
+  isolation: isolate;
+  overflow: hidden;
+  border: 1px solid rgb(var(--stage-rgb) / .28);
+  border-radius: 1.25rem;
+  background: #0d0b11;
+}
+.crazy-campaign-slide {
+  position: relative;
+  display: grid;
+  min-height: 18rem;
+  grid-template-rows: 1fr auto;
+}
+.crazy-campaign-glow {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  opacity: .25;
+  background: radial-gradient(ellipse at 70% 48%, rgb(var(--stage-rgb) / .9), transparent 62%);
+}
+.crazy-campaign-art {
+  display: block;
+  width: 100%;
+  max-height: clamp(21rem, 47vw, 35rem);
+  object-fit: contain;
+}
+.crazy-campaign-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: .6rem;
+  justify-content: center;
+  padding: .75rem 1rem 1rem;
+}
+.crazy-stage-button,
+.crazy-stage-catalog {
+  min-height: 2.75rem;
+  padding-inline: 1rem;
+  border-radius: .7rem;
+  font-weight: 800;
+}
+.crazy-stage-button {
+  background: rgb(var(--stage-rgb));
+  color: #141019;
+}
+.crazy-stage-button:hover { background: color-mix(in srgb, rgb(var(--stage-rgb)), white 20%); color: #141019; }
+
+.crazy-stage-controls { display: flex; align-items: center; justify-content: space-between; gap: .75rem; margin-top: .75rem; }
+.crazy-stage-tabs {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  min-width: 0;
+  gap: .4rem;
+}
+.crazy-stage-tabs button {
+  border: 1px solid var(--border);
+  border-radius: 999px;
+  background: var(--card);
+  color: var(--muted-foreground);
+  padding: .55rem .85rem;
+  cursor: pointer;
+  font-size: .75rem;
+  font-weight: 750;
+}
+.crazy-stage-tabs button[aria-pressed="true"] {
+  color: var(--foreground);
+  border-color: rgb(var(--stage-rgb) / .75);
+  background: rgb(var(--stage-rgb) / .12);
+}
+.crazy-stage-arrows { display: flex; gap: .35rem; flex: none; }
+.crazy-stage-tabs button:focus-visible,
+.crazy-brand-tile:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }
+
+.crazy-product-feature {
+  position: relative;
+  display: grid;
+  align-items: center;
+  background:
+    radial-gradient(ellipse at 75% 46%, rgb(var(--stage-rgb) / .28) 0%, transparent 61%),
+    linear-gradient(140deg, #1c1527, #0b090f 75%);
+}
+.crazy-feature-copy { z-index: 1; padding: clamp(1.25rem, 5vw, 4.75rem); }
+.crazy-feature-brand { color: rgb(var(--stage-rgb)); font-weight: 800; letter-spacing: .08em; text-transform: uppercase; font-size: .78rem; }
+.crazy-feature-copy h2 { margin-top: .55rem; color: #f9f6ff; font-size: clamp(1.65rem, 5vw, 4rem); font-weight: 850; line-height: 1.04; letter-spacing: -.05em; text-wrap: balance; }
+.crazy-feature-spec { margin-top: .7rem; color: #ddd6e9; }
+.crazy-feature-price { margin-block: .9rem; color: #fff; font-size: clamp(1.35rem, 3vw, 2.1rem); font-weight: 850; font-variant-numeric: tabular-nums; }
+.crazy-feature-scene { position: relative; isolation: isolate; display: grid; min-width: 0; min-height: clamp(14rem, 39vw, 32rem); place-items: center; }
+.crazy-feature-orbit { position: absolute; width: 79%; aspect-ratio: 1.8; border-radius: 50%; border: 1px solid rgb(var(--stage-rgb) / .36); box-shadow: inset 0 0 24px rgb(var(--stage-rgb) / .12), 0 0 30px rgb(var(--stage-rgb) / .14); transform: rotate(-21deg); }
+.crazy-feature-shadow { position: absolute; bottom: 11%; width: 46%; height: 4%; border-radius: 50%; background: #0008; filter: blur(9px); }
+.crazy-feature-float { position: relative; width: 88%; height: clamp(13rem, 36vw, 29rem); animation: crazy-levitate 5.4s ease-in-out infinite; }
+@keyframes crazy-levitate {
+  0%, 100% { transform: translateY(0) rotate(-5deg); }
+  50% { transform: translateY(-12px) rotate(-1deg); }
+}
+
+.crazy-brand-section { border-block: 1px solid var(--border); background: linear-gradient(150deg, #17121e, var(--background) 76%); }
+.crazy-brand-grid { display: grid; margin-top: 1.25rem; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; }
+.crazy-brand-tile {
+  --tile-rgb: 172 139 255;
+  position: relative;
+  display: flex;
+  align-items: end;
+  min-height: 9rem;
+  overflow: hidden;
+  isolation: isolate;
+  border: 1px solid rgb(var(--tile-rgb) / .32);
+  border-radius: .9rem;
+  padding: .7rem;
+  background: radial-gradient(ellipse at 81% 26%, rgb(var(--tile-rgb) / .24), transparent 72%), var(--card);
+}
+.crazy-brand-tile[data-brand="ignite"] { --tile-rgb: 231 165 94; }
+.crazy-brand-tile[data-brand="elfbar"] { --tile-rgb: 153 143 255; }
+.crazy-brand-tile[data-brand="lostmary"] { --tile-rgb: 126 220 188; }
+.crazy-brand-tile[data-brand="oxbar"] { --tile-rgb: 251 144 174; }
+.crazy-brand-tile[data-brand="waka"] { --tile-rgb: 113 172 250; }
+.crazy-brand-tile:hover { border-color: rgb(var(--tile-rgb) / .8); }
+.crazy-brand-product { position: absolute; z-index: -1; width: 76%; height: 82%; top: 1%; right: -9%; object-fit: contain; transform: rotate(-9deg); transition: transform .35s ease; }
+.crazy-brand-tile:hover .crazy-brand-product { transform: translateY(-5px) rotate(-4deg); }
+.crazy-brand-copy { display: grid; justify-items: start; gap: .35rem; padding: .4rem .5rem; max-width: 85%; border-radius: .45rem; background: #100e16e8; font-weight: 800; line-height: 1.2; }
+.crazy-brand-logo { width: auto; max-width: 4.9rem; height: 1.2rem; object-fit: contain; }
+.crazy-brand-count { color: var(--muted-foreground); font-size: .7rem; font-weight: 650; }
+.crazy-brand-arrow { position: absolute; right: .65rem; top: .65rem; width: .9rem; height: .9rem; }
+.crazy-category-section { background: radial-gradient(ellipse at 70% 0%, #20162b, var(--background) 72%); }
+
+@media (min-width: 768px) {
+  .crazy-product-feature { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: clamp(25rem, 47vw, 38.5rem); }
+  .crazy-brand-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
+  .crazy-brand-tile { min-height: 12rem; padding: 1rem; }
+  .crazy-brand-logo { max-width: 7rem; height: 1.5rem; }
+}
+@media (max-width: 767px) {
+  .crazy-stage-frame { padding: .65rem .75rem; }
+  .crazy-stage-controls { align-items: start; }
+  .crazy-stage-tabs button { padding: .4rem .55rem; }
+  .crazy-campaign-slide { min-height: 0; }
+  .crazy-feature-copy { grid-row: 2; padding-top: .5rem; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .crazy-feature-float { animation: none; }
+  .crazy-brand-product { transition: none; }
+}
