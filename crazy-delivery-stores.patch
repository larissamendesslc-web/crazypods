diff --git a/src/lib/delivery.ts b/src/lib/delivery.ts
new file mode 100644
index 0000000..318edac
--- /dev/null
+++ b/src/lib/delivery.ts
@@ -0,0 +1,183 @@
+import { z } from "zod";
+
+export const storeNames = {
+  quitauna: "Quitaúna",
+  jardimBoaVista: "Jardim Boa Vista",
+} as const;
+
+export type StoreId = keyof typeof storeNames;
+export type Coordinates = { latitude: number; longitude: number };
+export type DeliveryStore = {
+  whatsapp: string;
+  cep: string;
+  coordinates: Coordinates | null;
+};
+
+export const emptyStore: DeliveryStore = { whatsapp: "", cep: "", coordinates: null };
+export const emptyStores = { quitauna: emptyStore, jardimBoaVista: emptyStore };
+
+export const digits = (value: string) => value.replace(/\D/g, "");
+export const formatCep = (value: string) =>
+  digits(value)
+    .slice(0, 8)
+    .replace(/^(\d{5})(\d)/, "$1-$2");
+export const validWhatsApp = (value: string) => /^55[1-9]\d{9,10}$/.test(digits(value));
+export const whatsappLink = (number: string) => `https://wa.me/${digits(number)}?text=`;
+
+const coordinatesSchema = z.object({
+  latitude: z.number().min(-90).max(90),
+  longitude: z.number().min(-180).max(180),
+});
+
+const storeSchema = z.object({
+  whatsapp: z.string(),
+  cep: z.string(),
+  coordinates: coordinatesSchema.nullable(),
+});
+
+export function readDeliveryStores(value: unknown): Record<StoreId, DeliveryStore> {
+  const stores = z
+    .object({
+      quitauna: storeSchema.catch(emptyStore).default(emptyStore),
+      jardimBoaVista: storeSchema.catch(emptyStore).default(emptyStore),
+    })
+    .safeParse(value);
+  return stores.success ? stores.data : emptyStores;
+}
+
+const storeIds: StoreId[] = ["quitauna", "jardimBoaVista"];
+
+export function activeStores(stores: Record<StoreId, DeliveryStore>) {
+  return storeIds.flatMap((id) => {
+    const store = stores[id];
+    if (!validWhatsApp(store.whatsapp) || digits(store.cep).length !== 8 || !store.coordinates)
+      return [];
+    return [{ ...store, id, name: storeNames[id], coordinates: store.coordinates }];
+  });
+}
+
+export type ActiveStore = ReturnType<typeof activeStores>[number];
+
+export function distanceKm(origin: Coordinates, destination: Coordinates) {
+  const radians = Math.PI / 180;
+  const lat = (destination.latitude - origin.latitude) * radians;
+  const lon = (destination.longitude - origin.longitude) * radians;
+  const haversine =
+    Math.sin(lat / 2) ** 2 +
+    Math.cos(origin.latitude * radians) *
+      Math.cos(destination.latitude * radians) *
+      Math.sin(lon / 2) ** 2;
+  return 2 * 6371.0088 * Math.asin(Math.sqrt(Math.min(1, haversine)));
+}
+
+export function nearestStore(stores: ActiveStore[], point: Coordinates) {
+  return stores
+    .map((store) => ({ store, km: distanceKm(store.coordinates, point) }))
+    .sort((first, second) => first.km - second.km)[0];
+}
+
+export type DeliveryAddress = {
+  cep: string;
+  street: string;
+  district: string;
+  city: string;
+  state: string;
+  coordinates: Coordinates | null;
+};
+
+const viaCepAddress = z.object({
+  cep: z.string().regex(/^\d{5}-?\d{3}$/),
+  logradouro: z.string(),
+  bairro: z.string(),
+  localidade: z.string().min(1),
+  uf: z.string().regex(/^[A-Z]{2}$/),
+});
+
+const brasilAddress = z.object({
+  cep: z.string().regex(/^\d{5}-?\d{3}$/),
+  street: z.string().optional(),
+  neighborhood: z.string().optional(),
+  city: z.string().min(1),
+  state: z.string().regex(/^[A-Z]{2}$/),
+  location: z.object({ coordinates: z.unknown().optional() }).optional(),
+});
+
+function point(value: unknown) {
+  const raw = z
+    .object({
+      latitude: z.union([z.number(), z.string().trim().min(1)]),
+      longitude: z.union([z.number(), z.string().trim().min(1)]),
+    })
+    .safeParse(value);
+  if (!raw.success) return null;
+  const parsed = coordinatesSchema.safeParse({
+    latitude: Number(raw.data.latitude),
+    longitude: Number(raw.data.longitude),
+  });
+  if (!parsed.success || (parsed.data.latitude === 0 && parsed.data.longitude === 0)) return null;
+  return parsed.data;
+}
+
+async function getJson(url: string, signal?: AbortSignal): Promise<unknown> {
+  const timeout = AbortSignal.timeout(4500);
+  const response = await fetch(url, {
+    signal: signal ? AbortSignal.any([signal, timeout]) : timeout,
+  });
+  if (!response.ok) return null;
+  return response.json();
+}
+
+export async function lookupCep(
+  value: string,
+  signal?: AbortSignal,
+): Promise<DeliveryAddress | null> {
+  const cep = digits(value);
+  if (cep.length !== 8) return null;
+  const [direct, geo] = await Promise.allSettled([
+    getJson(`https://viacep.com.br/ws/${cep}/json/`, signal),
+    getJson(`https://brasilapi.com.br/api/cep/v2/${cep}`, signal),
+  ]);
+  signal?.throwIfAborted();
+  const postal = viaCepAddress.safeParse(direct.status === "fulfilled" ? direct.value : null);
+  const geocoded = brasilAddress.safeParse(geo.status === "fulfilled" ? geo.value : null);
+  const matched = geocoded.success && digits(geocoded.data.cep) === cep ? geocoded.data : null;
+  const coordinates = point(matched?.location?.coordinates);
+  if (postal.success && digits(postal.data.cep) === cep) {
+    return {
+      cep: formatCep(cep),
+      street: postal.data.logradouro || matched?.street || "",
+      district: postal.data.bairro || matched?.neighborhood || "",
+      city: postal.data.localidade,
+      state: postal.data.uf,
+      coordinates,
+    };
+  }
+  if (!matched && direct.status === "rejected" && geo.status === "rejected") {
+    throw new Error("A consulta de CEP está indisponível. Tente novamente.");
+  }
+  return matched
+    ? {
+        cep: formatCep(cep),
+        street: matched.street ?? "",
+        district: matched.neighborhood ?? "",
+        city: matched.city,
+        state: matched.state,
+        coordinates,
+      }
+    : null;
+}
+
+export async function searchPostalAddresses(city: string, street: string, signal?: AbortSignal) {
+  const url = `https://viacep.com.br/ws/SP/${encodeURIComponent(city.trim())}/${encodeURIComponent(street.trim())}/json/`;
+  const rows = z.array(viaCepAddress).safeParse(await getJson(url, signal));
+  if (!rows.success) throw new Error("Não foi possível pesquisar o endereço. Tente novamente.");
+  return rows.data
+    .map((address) => ({
+      cep: formatCep(address.cep),
+      street: address.logradouro,
+      district: address.bairro,
+      city: address.localidade,
+      state: address.uf,
+    }))
+    .slice(0, 25);
+}
