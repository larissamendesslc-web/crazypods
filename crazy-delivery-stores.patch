@@ -0,0 +1,89 @@
+import { useState } from "react";
+import { useQuery } from "@tanstack/react-query";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import { searchPostalAddresses } from "@/lib/delivery";
+
+export function CheckoutCepSearch({ onSelect }: { onSelect: (cep: string) => void }) {
+  const [city, setCity] = useState("Osasco");
+  const [street, setStreet] = useState("");
+  const [search, setSearch] = useState<{ city: string; street: string }>();
+  const results = useQuery({
+    queryKey: ["checkout-address-search", search],
+    enabled: !!search,
+    queryFn: ({ signal }) =>
+      searchPostalAddresses(search?.city ?? "", search?.street ?? "", signal),
+    retry: false,
+    staleTime: 60_000,
+    gcTime: 0,
+  });
+
+  function findCep() {
+    const query = { city: city.trim(), street: street.trim() };
+    if (query.city === search?.city && query.street === search?.street) {
+      void results.refetch();
+    } else {
+      setSearch(query);
+    }
+  }
+
+  return (
+    <div className="space-y-3 rounded-xl border border-border bg-card p-3">
+      <p className="text-sm font-bold">Encontre seu CEP em São Paulo</p>
+      <label className="block text-sm">
+        Cidade
+        <Input
+          value={city}
+          maxLength={80}
+          className="mt-1 text-base"
+          onChange={(event) => setCity(event.target.value)}
+        />
+      </label>
+      <label className="block text-sm">
+        Rua ou avenida
+        <Input
+          value={street}
+          maxLength={120}
+          className="mt-1 text-base"
+          onChange={(event) => setStreet(event.target.value)}
+        />
+      </label>
+      <Button
+        type="button"
+        variant="outline"
+        disabled={city.trim().length < 3 || street.trim().length < 3 || results.isFetching}
+        onClick={findCep}
+      >
+        {results.isFetching ? "Pesquisando…" : "Pesquisar CEP"}
+      </Button>
+      {results.isError && (
+        <p role="alert" className="text-sm text-destructive">
+          A pesquisa falhou. Tente novamente.
+        </p>
+      )}
+      {results.data?.length === 0 && (
+        <p role="status" className="text-sm text-muted-foreground">
+          Nenhum CEP encontrado. Confira a cidade e o nome da rua.
+        </p>
+      )}
+      {!!results.data?.length && (
+        <ul className="max-h-56 space-y-1 overflow-y-auto" aria-label="CEPs encontrados">
+          {results.data.map((address, i) => (
+            <li key={`${address.cep}-${i}`}>
+              <button
+                type="button"
+                onClick={() => onSelect(address.cep)}
+                className="w-full rounded-lg border border-border p-2 text-left text-sm hover:bg-secondary"
+              >
+                <span className="font-semibold">{address.street}</span>
+                <span className="block text-xs text-muted-foreground">
+                  {[address.district, address.city, address.cep].filter(Boolean).join(" · ")}
+                </span>
+              </button>
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
diff --git a/src/components/delivery-stores-settings.tsx b/src/components/delivery-stores-settings.tsx
new file mode 100644
index 0000000..7d361ec
--- /dev/null
+++ b/src/components/delivery-stores-settings.tsx
@@ -0,0 +1,168 @@
+import { useState } from "react";
+import { toast } from "sonner";
+import { Button } from "@/components/ui/button";
+import { Input } from "@/components/ui/input";
+import {
+  digits,
+  formatCep,
+  lookupCep,
+  storeNames,
+  type DeliveryStore,
+  type StoreId,
+} from "@/lib/delivery";
+
+type Props = {
+  id: StoreId;
+  store: DeliveryStore;
+  onChange: (store: DeliveryStore) => void;
+};
+
+export function DeliveryStoreSettings({ id, store, onChange }: Props) {
+  const [busy, setBusy] = useState(false);
+  const name = storeNames[id];
+  const [manual, setManual] = useState(false);
+  const [latitude, setLatitude] = useState("");
+  const [longitude, setLongitude] = useState("");
+
+  function saveCoordinates() {
+    const lat = Number(latitude.trim().replace(",", "."));
+    const lon = Number(longitude.trim().replace(",", "."));
+    if (
+      !latitude.trim() ||
+      !longitude.trim() ||
+      !Number.isFinite(lat) ||
+      !Number.isFinite(lon) ||
+      lat < -24 ||
+      lat > -23 ||
+      lon < -47 ||
+      lon > -46 ||
+      digits(store.cep).length !== 8
+    ) {
+      toast.error("Confira o CEP da unidade e as coordenadas do ponto em Osasco.");
+      return;
+    }
+    onChange({ ...store, coordinates: { latitude: lat, longitude: lon } });
+    setManual(false);
+  }
+
+  async function locate() {
+    setBusy(true);
+    try {
+      const address = await lookupCep(store.cep);
+      if (
+        !address?.coordinates ||
+        address.city.toLowerCase() !== "osasco" ||
+        address.state !== "SP"
+      ) {
+        toast.error("Não encontramos coordenadas para esse CEP em Osasco.");
+        return;
+      }
+      onChange({ ...store, cep: address.cep, coordinates: address.coordinates });
+      toast.success([address.street, address.district, address.city].filter(Boolean).join(" · "));
+    } catch {
+      toast.error("Não foi possível consultar esse CEP.");
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  return (
+    <fieldset disabled={busy} className="min-w-0 rounded-xl border border-border p-4">
+      <legend className="px-2 text-sm font-bold">{name} · Osasco</legend>
+      <div className="space-y-3">
+        <label className="block text-sm font-medium">
+          WhatsApp · 55 + DDD + número
+          <Input
+            value={store.whatsapp}
+            type="tel"
+            placeholder="55 + DDD + número"
+            className="mt-1"
+            maxLength={24}
+            onChange={(event) => onChange({ ...store, whatsapp: event.target.value })}
+          />
+        </label>
+        <div className="flex flex-wrap items-end gap-2">
+          <label className="min-w-28 flex-1 text-sm font-medium">
+            CEP da unidade
+            <Input
+              value={store.cep}
+              inputMode="numeric"
+              placeholder="00000-000"
+              className="mt-1"
+              onChange={(event) =>
+                onChange({ ...store, cep: formatCep(event.target.value), coordinates: null })
+              }
+            />
+          </label>
+          <Button
+            type="button"
+            variant="outline"
+            disabled={digits(store.cep).length !== 8}
+            onClick={locate}
+          >
+            {busy ? "Consultando…" : "Localizar"}
+          </Button>
+        </div>
+        <p className="text-xs text-muted-foreground">
+          {store.coordinates
+            ? "Ponto de referência configurado."
+            : "Informe o CEP e localize o ponto de referência da unidade."}
+        </p>
+        <Button
+          type="button"
+          variant="outline"
+          size="sm"
+          aria-expanded={manual}
+          onClick={() => {
+            setLatitude(store.coordinates?.latitude.toString() ?? "");
+            setLongitude(store.coordinates?.longitude.toString() ?? "");
+            setManual((open) => !open);
+          }}
+        >
+          {manual ? "Fechar coordenadas" : "Informar coordenadas do mapa"}
+        </Button>
+        {manual && (
+          <div className="grid grid-cols-2 gap-2">
+            <label className="text-sm">
+              Latitude
+              <Input
+                value={latitude}
+                inputMode="decimal"
+                maxLength={24}
+                onChange={(e) => setLatitude(e.target.value)}
+              />
+            </label>
+            <label className="text-sm">
+              Longitude
+              <Input
+                value={longitude}
+                inputMode="decimal"
+                maxLength={24}
+                onChange={(e) => setLongitude(e.target.value)}
+              />
+            </label>
+            <Button
+              type="button"
+              variant="secondary"
+              size="sm"
+              className="col-span-2"
+              onClick={saveCoordinates}
+            >
+              Usar este ponto
+            </Button>
+          </div>
+        )}
+        {(store.whatsapp || store.cep) && (
+          <Button
+            type="button"
+            variant="ghost"
+            size="sm"
+            onClick={() => onChange({ whatsapp: "", cep: "", coordinates: null })}
+          >
+            Limpar unidade
+          </Button>
+        )}
+      </div>
+    </fieldset>
+  );
+}
