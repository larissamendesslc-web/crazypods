+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { CartCheckout } from "./cart-checkout";
+
+const { createOrder } = vi.hoisted(() => ({ createOrder: vi.fn() }));
+vi.mock("@/lib/orders", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@/lib/orders")>()),
+  ordersClient: { rpc: createOrder },
+}));
+
+describe("checkout delivery routing", () => {
+  beforeEach(() => {
+    sessionStorage.clear();
+    createOrder.mockReset();
+    vi.restoreAllMocks();
+  });
+
+  it("routes to the closer store and reopens WhatsApp with the saved number and order code", async () => {
+    const onComplete = vi.fn();
+    const stores = {
+      quitauna: {
+        whatsapp: "5511900000001",
+        cep: "06000-001",
+        coordinates: { latitude: -23.52, longitude: -46.79 },
+      },
+      jardimBoaVista: {
+        whatsapp: "5511900000002",
+        cep: "06000-002",
+        coordinates: { latitude: -23.57, longitude: -46.81 },
+      },
+    };
+    const replace = vi.fn();
+    vi.spyOn(window, "open").mockImplementation(
+      () => ({ location: { replace }, close: vi.fn() }) as unknown as Window,
+    );
+    vi.spyOn(globalThis, "fetch").mockImplementation(
+      async (url) =>
+        new Response(
+          JSON.stringify(
+            String(url).includes("viacep")
+              ? {
+                  cep: "06000-003",
+                  logradouro: "Rua Teste",
+                  bairro: "Bairro Teste",
+                  localidade: "Osasco",
+                  uf: "SP",
+                }
+              : {
+                  cep: "06000003",
+                  city: "Osasco",
+                  state: "SP",
+                  location: { coordinates: { latitude: "-23.569", longitude: "-46.809" } },
+                },
+          ),
+        ),
+    );
+    createOrder.mockResolvedValue({ data: "0042", error: null });
+    const client = new QueryClient();
+    const props = {
+      whatsappBase: "https://wa.me/5511900000000?text=",
+      deliveryStores: stores,
+      onComplete,
+      onClear: vi.fn(),
+    };
+    const items = [{ id: "item", name: "Produto de teste", flavor: null, price: 100, qty: 1 }];
+    const wrapper = (cart: typeof items) => (
+      <QueryClientProvider client={client}>
+        <CartCheckout {...props} items={cart}>
+          Itens
+        </CartCheckout>
+      </QueryClientProvider>
+    );
+    const view = render(wrapper(items));
+    fireEvent.change(screen.getByLabelText("Nome completo"), {
+      target: { value: "Pessoa Fictícia" },
+    });
+    fireEvent.change(screen.getByLabelText("Telefone com DDD"), {
+      target: { value: "11999990000" },
+    });
+    fireEvent.change(screen.getByLabelText("CEP", { exact: true }), {
+      target: { value: "06000003" },
+    });
+    await screen.findByText("Unidade Jardim Boa Vista");
+    fireEvent.change(screen.getByLabelText("Número"), { target: { value: "12" } });
+    fireEvent.change(screen.getByLabelText(/Complemento/), { target: { value: "Bloco B" } });
+    fireEvent.click(screen.getByRole("button", { name: "Enviar pedido no WhatsApp" }));
+    await waitFor(() => expect(onComplete).toHaveBeenCalledOnce());
+    expect(createOrder).toHaveBeenCalledWith(
+      "create_shop_order",
+      expect.objectContaining({
+        p_address: "Rua Teste, 12 · Bloco B · Bairro Teste · Osasco - SP · CEP 06000-003",
+      }),
+    );
+    const url = new URL(String(replace.mock.calls[0]?.[0]));
+    expect(url.pathname).toBe("/5511900000002");
+    expect(url.searchParams.get("text")).toBe("OLÁ, JÁ FIZ MEU PEDIDO, CÓDIGO: 0042");
+    view.unmount();
+    render(wrapper([]));
+    expect(screen.getByRole("link", { name: "Abrir WhatsApp" })).toHaveAttribute("href", url.href);
+    client.clear();
+  });
+});
